5️⃣ Auth View —  AuthView.swift 
 
swift  
import SwiftUI
import Supabase

struct AuthView: View {
  @State private var email = ""
  @State private var isLoading = false
  @State private var result: Result<Void, Error>?

  var body: some View {
    Form {
      Section {
        TextField("Email", text: $email)
          .textContentType(.emailAddress)
          .textInputAutocapitalization(.never)
          .autocorrectionDisabled()
      }
      Section {
        Button("Sign In / Magic Link") { signInTapped() }
        if isLoading { ProgressView() }
      }
      if let result {
        Section {
          switch result {
          case .success: Text("✅ Check your email!")
          case .failure(let e): Text("❌ \(e.localizedDescription)").foregroundColor(.red)
          }
        }
      }
    }
    .onOpenURL { url in
      Task { do { try await supabase.auth.session(from: url) }
            catch { result = .failure(error) } }
    }
  }

  func signInTapped() {
    Task {
      isLoading = true; defer { isLoading = false }
      do {
        try await supabase.auth.signInWithOTP(
          email: email,
          redirectTo: URL(string: "io.supabase.user-management://login-callback")
        )
        result = .success(())
      } catch { result = .failure(error) }
    }
  }
}
