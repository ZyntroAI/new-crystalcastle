## 6️⃣ Avatar Helper — `AvatarImage.swift`
```swift
import SwiftUI
import PhotosUI

struct AvatarImage: Transferable, Equatable {
  let image: Image
  let data: Data

  static var transferRepresentation: some TransferRepresentation {
    DataRepresentation(importedContentType: .image) { data in
      guard let img = AvatarImage(data: data) else { throw TransferError.importFailed }
      return img
    }
  }
}

extension AvatarImage {
  init?(data: Data) {
    guard let uiImg = UIImage(data: data) else { return nil }
    image = Image(uiImage: uiImg)
    self.data = data
  }
}

enum TransferError: Error { case importFailed }
 
 
 
 
7️⃣ Profile View —  ProfileView.swift 
 
swift  
import SwiftUI
import PhotosUI
import Supabase

struct ProfileView: View {
  @State private var username = ""
  @State private var fullName = ""
  @State private var website = ""
  @State private var isLoading = false
  @State private var imageSelection: PhotosPickerItem?
  @State private var avatarImage: AvatarImage?

  var body: some View {
    NavigationStack {
      Form {
        Section {
          HStack {
            Group {
              if let avatarImage { avatarImage.image.resizable() }
              else { Color.clear }
            }
            .scaledToFit().frame(width: 80, height: 80)
            Spacer()
            PhotosPicker(selection: $imageSelection, matching: .images) {
              Image(systemName: "pencil.circle.fill")
                .symbolRenderingMode(.multicolor)
                .font(.system(size: 30))
            }
          }
        }
        Section {
          TextField("Username", text: $username)
            .textContentType(.username).textInputAutocapitalization(.never)
          TextField("Full Name", text: $fullName).textContentType(.name)
          TextField("Website", text: $website)
            .textContentType(.URL).textInputAutocapitalization(.never)
        }
        Section {
          Button("Update Profile") { updateTapped() }.bold()
          if isLoading { ProgressView() }
        }
      }
      .navigationTitle("Profile")
      .toolbar {
        ToolbarItem(placement: .topBarTrailing) {
          Button("Sign Out", role: .destructive) {
            Task { try? await supabase.auth.signOut() }
          }
        }
      }
      .onChange(of: imageSelection) { _, new in
        guard let new else { return }
        Task { avatarImage = try? await new.loadTransferable(type: AvatarImage.self) }
      }
    }
    .task { await loadProfile() }
  }

  func loadProfile() async {
    do {
      let user = try await supabase.auth.session.user
      let profile: Profile = try await supabase
        .from("profiles")
        .select()
        .eq("id", value: user.id)
        .single()
        .execute().value

      username = profile.username ?? ""
      fullName = profile.fullName ?? ""
      website = profile.website ?? ""

      if let path = profile.avatarURL, !path.isEmpty {
        let data = try await supabase.storage.from("avatars").download(path: path)
        avatarImage = AvatarImage(data: data)
      }
    } catch { debugPrint(error) }
  }

  func updateTapped() {
    Task {
      isLoading = true; defer { isLoading = false }
      do {
        let user = try await supabase.auth.session.user
        var avatarPath: String?
        if let data = avatarImage?.data {
          let fileName = "\(UUID().uuidString).jpeg"
          try await supabase.storage.from("avatars").upload(
            fileName, data: data,
            options: .init(contentType: "image/jpeg")
          )
          avatarPath = fileName
        }
        try await supabase.from("profiles").update(Profile(
          username: username, fullName: fullName,
          website: website, avatarURL: avatarPath
        )).eq("id", value: user.id).execute()
      } catch { debugPrint(error) }
    }
  }
}
