## 📁 Step 1 — Dedicated Schema Migration
**File:** `supabase/migrations/202609230003_agent_runtime_schema.sql`

```sql
begin;

-- Enable extensions
create extension if not exists pgcrypto;

-- Create isolated schema
create schema if not exists agent_runtime;
revoke all on schema agent_runtime from public, anon, authenticated;
grant usage on schema agent_runtime to service_role;

-- Role type
create type agent_runtime.org_role as enum ('owner','admin','operator','developer','viewer');

-- Organizations
create table agent_runtime.organizations (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  created_at timestamptz default now()
);

-- Memberships
create table agent_runtime.organization_members (
  org_id uuid references agent_runtime.organizations(id) on delete cascade,
  user_id uuid not null,
  role agent_runtime.org_role not null default 'viewer',
  created_at timestamptz default now(),
  primary key (org_id, user_id)
);

-- Permission versioning
create table agent_runtime.permission_sets (
  id uuid primary key default gen_random_uuid(),
  version text not null unique,
  description text,
  active boolean not null default false,
  status text not null default 'draft',
  approved_by uuid,
  activated_at timestamptz,
  created_at timestamptz default now()
);
create unique index one_active_permission_set
  on agent_runtime.permission_sets(active) where active = true;

-- Permission rules
create table agent_runtime.permission_rules (
  permission_set_id uuid references agent_runtime.permission_sets(id) on delete cascade,
  skill_name text not null,
  capability text not null,
  allowed boolean not null,
  created_at timestamptz default now(),
  primary key (permission_set_id, skill_name, capability)
);

-- Skill registry
create table agent_runtime.skill_registry (
  id uuid primary key default gen_random_uuid(),
  skill_name text not null unique,
  version text not null,
  enabled boolean not null default true,
  metadata jsonb not null default '{}',
  created_at timestamptz default now()
);

-- Executions
create table agent_runtime.executions (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null,
  org_id uuid references agent_runtime.organizations(id),
  request text not null,
  status text not null,
  created_at timestamptz default now()
);

-- Runtime snapshots
create table agent_runtime.runtime_executions (
  execution_id uuid primary key,
  user_id uuid not null,
  org_id uuid,
  permission_version text,
  permission_snapshot jsonb,
  retry_count integer not null default 0,
  status text,
  started_at timestamptz,
  completed_at timestamptz
);

-- Self‑healing events
create table agent_runtime.self_healing_events (
  id uuid primary key default gen_random_uuid(),
  execution_id uuid not null,
  retry_number integer not null,
  error_text text,
  repair_strategy text,
  success boolean not null,
  created_at timestamptz default now()
);

-- Adapter registry
create table agent_runtime.adapter_registry (
  adapter_name text primary key,
  provider text not null,
  enabled boolean not null default true,
  version text,
  metadata jsonb not null default '{}',
  created_at timestamptz default now()
);

-- Immutable audit logs
create table agent_runtime.audit_logs (
  id bigint generated always as identity primary key,
  event_id uuid not null default gen_random_uuid(),
  created_at timestamptz not null default now(),
  user_id uuid,
  execution_id uuid,
  org_id uuid,
  skill_name text,
  capability text,
  authorized boolean,
  result text,
  metadata jsonb not null default '{}'
);

-- Indexes
create index idx_exec_user on agent_runtime.executions(user_id);
create index idx_exec_org on agent_runtime.executions(org_id);
create index idx_runtime_exec_user on agent_runtime.runtime_executions(user_id);
create index idx_audit_user on agent_runtime.audit_logs(user_id);
create index idx_audit_exec on agent_runtime.audit_logs(execution_id);
create index idx_audit_time on agent_runtime.audit_logs(created_at desc);

-- Helper functions
create or replace function agent_runtime.role_rank(role_name agent_runtime.org_role)
returns integer language sql immutable as $$
select case role_name
  when 'owner' then 100 when 'admin' then 80
  when 'operator' then 60 when 'developer' then 40 else 20 end;
$$;

create or replace function agent_runtime.has_minimum_role(p_org_id uuid, min_role agent_runtime.org_role)
returns boolean language sql stable as $$
select exists(
  select 1 from agent_runtime.organization_members om
  where om.org_id = p_org_id
    and om.user_id = auth.uid()
    and agent_runtime.role_rank(om.role) >= agent_runtime.role_rank(min_role)
);
$$;

-- Enable RLS
alter table agent_runtime.organizations enable row level security;
alter table agent_runtime.organization_members enable row level security;
alter table agent_runtime.executions enable row level security;
alter table agent_runtime.runtime_executions enable row level security;
alter table agent_runtime.audit_logs enable row level security;
alter table agent_runtime.self_healing_events enable row level security;

-- Org policies
create policy organizations_view on agent_runtime.organizations
  for select to authenticated using (agent_runtime.has_minimum_role(id, 'viewer'));
create policy organizations_update on agent_runtime.organizations
  for update to authenticated using (agent_runtime.has_minimum_role(id, 'admin'));
create policy organizations_delete on agent_runtime.organizations
  for delete to authenticated using (agent_runtime.has_minimum_role(id, 'owner'));

-- Member policies
create policy member_view on agent_runtime.organization_members
  for select to authenticated using (agent_runtime.has_minimum_role(org_id, 'viewer'));

-- Execution policies
create policy execution_select on agent_runtime.executions
  for select to authenticated using (user_id = auth.uid());
create policy execution_insert on agent_runtime.executions
  for insert to authenticated with check (user_id = auth.uid());
create policy execution_update on agent_runtime.executions
  for update to authenticated using (user_id = auth.uid());

-- Audit policies
create policy audit_read on agent_runtime.audit_logs
  for select to authenticated using (user_id = auth.uid());
create policy audit_insert on agent_runtime.audit_logs
  for insert to authenticated with check (user_id = auth.uid());

-- Immutable trigger
create or replace function agent_runtime.prevent_audit_modification()
returns trigger language plpgsql as $$
begin raise exception 'audit logs are immutable'; end; $$;

create trigger audit_no_update before update on agent_runtime.audit_logs
  for each row execute function agent_runtime.prevent_audit_modification();
create trigger audit_no_delete before delete on agent_runtime.audit_logs
  for each row execute function agent_runtime.prevent_audit_modification();

-- Lock down control tables — service_role only
revoke all on agent_runtime.permission_sets, agent_runtime.permission_rules,
  agent_runtime.skill_registry, agent_runtime.adapter_registry
  from anon, authenticated;

grant all on agent_runtime.permission_sets, agent_runtime.permission_rules,
  agent_runtime.skill_registry, agent_runtime.adapter_registry
  to service_role;

commit;
