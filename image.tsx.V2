3️⃣  cache/base.ts 
 
ts
  
import type { CacheEntry } from "./types";

export abstract class BaseCacheStore {
  protected isExpired(entry: CacheEntry): boolean {
    return Date.now() - entry.createdAt > entry.ttl;
  }

  protected touchEntry(entry: CacheEntry): CacheEntry {
    return { ...entry, accessedAt: Date.now() };
  }
}
 
 
4️⃣  cache/memory-store.ts 
 
ts
  
import type { ICacheStore, CacheEntry } from "./types";
import { BaseCacheStore } from "./base";
import { CACHE_CONFIG } from "../constants";

export class MemoryCacheStore extends BaseCacheStore implements ICacheStore {
  readonly name = "memory";
  private store = new Map<string, CacheEntry>();

  async get(key: string): Promise<CacheEntry | null> {
    const entry = this.store.get(key);
    if (!entry) return null;
    if (this.isExpired(entry)) {
      this.store.delete(key);
      return null;
    }
    this.store.set(key, this.touchEntry(entry));
    return entry;
  }

  async set(key: string, entry: Omit<CacheEntry, "createdAt" | "accessedAt">): Promise<void> {
    this.evictIfNeeded(entry.size);
    const newEntry: CacheEntry = {
      ...entry,
      createdAt: Date.now(),
      accessedAt: Date.now(),
    };
    this.store.set(key, newEntry);
  }

  async delete(key: string): Promise<boolean> {
    return this.store.delete(key);
  }

  async has(key: string): Promise<boolean> {
    const entry = await this.get(key);
    return !!entry;
  }

  async keys(): Promise<string[]> {
    return Array.from(this.store.keys());
  }

  async clear(): Promise<void> {
    this.store.clear();
  }

  async getSize(): Promise<number> {
    let total = 0;
    this.store.forEach(e => total += e.size);
    return total;
  }

  private async evictIfNeeded(additional: number): Promise<void> {
    const currentSize = await this.getSize();
    if (currentSize + additional <= CACHE_CONFIG.MAX_MEMORY_SIZE) return;

    const entries = Array.from(this.store.values())
      .sort((a, b) => a.accessedAt - b.accessedAt); // LRU

    let freed = 0;
    for (const entry of entries) {
      freed += entry.size;
      this.store.delete(entry.key);
      if (currentSize + additional - freed <= CACHE_CONFIG.MAX_MEMORY_SIZE * CACHE_CONFIG.EVICTION_THRESHOLD) break;
    }
  }
}
 
 
5️⃣  cache/idb-store.ts 
 
ts
  
import type { ICacheStore, CacheEntry } from "./types";
import { BaseCacheStore } from "./base";
import { CACHE_CONFIG } from "../constants";

export class IDBCacheStore extends BaseCacheStore implements ICacheStore {
  readonly name = "indexedDB";
  private db: IDBDatabase | null = null;

  async init(): Promise<void> {
    return new Promise((resolve, reject) => {
      const req = indexedDB.open(CACHE_CONFIG.DB_NAME, CACHE_CONFIG.DB_VERSION);
      req.onupgradeneeded = e => {
        const db = (e.target as IDBOpenDBRequest).result;
        if (!db.objectStoreNames.contains(CACHE_CONFIG.STORE_NAME)) {
          const store = db.createObjectStore(CACHE_CONFIG.STORE_NAME, { keyPath: "key" });
          store.createIndex("createdAt", "createdAt");
          store.createIndex("accessedAt", "accessedAt");
        }
      };
      req.onsuccess = e => { this.db = (e.target as IDBOpenDBRequest).result; resolve(); };
      req.onerror = reject;
    });
  }

  private getDB(): IDBDatabase {
    if (!this.db) throw new Error("IDB not initialized");
    return this.db;
  }

  async get(key: string): Promise<CacheEntry | null> {
    if (!this.db) await this.init();
    return new Promise((resolve, reject) => {
      const tx = this.getDB().transaction(CACHE_CONFIG.STORE_NAME, "readwrite");
      const store = tx.objectStore(CACHE_CONFIG.STORE_NAME);
      const req = store.get(key);
      req.onsuccess = () => {
        const entry = req.result as CacheEntry | undefined;
        if (!entry) return resolve(null);
        if (this.isExpired(entry)) { store.delete(key); resolve(null); return; }
        store.put(this.touchEntry(entry));
        resolve(entry);
      };
      req.onerror = reject;
    });
  }

  async set(key: string, entry: Omit<CacheEntry, "createdAt" | "accessedAt">): Promise<void> {
    if (!this.db) await this.init();
    const fullEntry: CacheEntry = { ...entry, key, createdAt: Date.now(), accessedAt: Date.now() };
    return new Promise((resolve, reject) => {
      const tx = this.getDB().transaction(CACHE_CONFIG.STORE_NAME, "readwrite");
      tx.objectStore(CACHE_CONFIG.STORE_NAME).put(fullEntry);
      tx.oncomplete = resolve;
      tx.onerror = reject;
    });
  }

  async delete(key: string): Promise<boolean> {
    if (!this.db) await this.init();
    return new Promise(resolve => {
      const req = this.getDB().transaction(CACHE_CONFIG.STORE_NAME, "readwrite").objectStore(CACHE_CONFIG.STORE_NAME).delete(key);
      req.onsuccess = () => resolve(true);
    });
  }

  async has(key: string): Promise<boolean> {
    return !!(await this.get(key));
  }

  async keys(): Promise<string[]> {
    if (!this.db) await this.init();
    return new Promise(resolve => {
      const req = this.getDB().transaction(CACHE_CONFIG.STORE_NAME).objectStore(CACHE_CONFIG.STORE_NAME).getAllKeys();
      req.onsuccess = () => resolve(req.result as string[]);
    });
  }

  async clear(): Promise<void> {
    if (!this.db) await this.init();
    return new Promise(resolve => {
      this.getDB().transaction(CACHE_CONFIG.STORE_NAME, "readwrite").objectStore(CACHE_CONFIG.STORE_NAME).clear();
      resolve();
    });
  }

  async getSize(): Promise<number> {
    // ประมาณการขนาด / หรือเก็บไว้ในเมตาดาต้า
    const keys = await this.keys();
    return keys.length * 1024; // placeholder
  }
}
 
 
6️⃣  cache/cache-manager.ts 
 
ts
  
import type { CacheTier, CacheEntry, CacheStats } from "./types";
import { MemoryCacheStore, IDBCacheStore } from "./";
import { CACHE_CONFIG } from "../constants";

export class ImageCacheManager {
  private static instance: ImageCacheManager;
  private stores: Map<CacheTier, MemoryCacheStore | IDBCacheStore>;
  private stats: CacheStats = { hits: 0, misses: 0, size: 0, count: 0 };

  private constructor() {
    this.stores = new Map([
      ["memory", new MemoryCacheStore()],
      ["indexedDB", new IDBCacheStore()],
    ]);
  }

  static getInstance(): ImageCacheManager {
    if (!ImageCacheManager.instance) ImageCacheManager.instance = new ImageCacheManager();
    return ImageCacheManager.instance;
  }

  async get(key: string): Promise<CacheEntry | null> {
    // ตรวจสอบตามลำดับ: หน่วยความจำ → IndexedDB
    for (const [tier, store] of this.stores) {
      const entry = await store.get(key);
      if (entry) {
        this.stats.hits++;
        // เขียนคืนชั้นบน (ถ้ามาจาก IDB → ใส่ Memory)
        if (tier === "indexedDB") await this.setInTier("memory", key, entry);
        return entry;
      }
    }
    this.stats.misses++;
    return null;
  }

  async set(key: string, data: string, meta: Partial<CacheEntry> = {}): Promise<void> {
    const entry: Omit<CacheEntry, "createdAt" | "accessedAt"> = {
      key,
      data,
      size: new Blob([data]).size,
      ttl: CACHE_CONFIG.DEFAULT_TTL,
      ...meta,
    };
    await this.setInTier("memory", key, entry);
    await this.setInTier("indexedDB", key, entry);
  }

  private async setInTier(tier: CacheTier, key: string, entry: Omit<CacheEntry, "createdAt" | "accessedAt">): Promise<void> {
    const store = this.stores.get(tier);
    if (store) await store.set(key, entry);
  }

  async delete(key: string): Promise<void> {
    for (const store of this.stores.values()) await store.delete(key);
  }

  async clear(): Promise<void> {
    for (const store of this.stores.values()) await store.clear();
  }

  getStats(): CacheStats { return { ...this.stats }; }
  resetStats(): void { this.stats = { hits: 0, misses: 0, size: 0, count: 0 }; }

  generateKey(src: string, format: string): string {
    return btoa(`${src}:${format}`).replace(/[^a-zA-Z0-9]/g, "");
  }
}

// Singleton Export
export const imageCache = ImageCacheManager.getInstance();
 
 
