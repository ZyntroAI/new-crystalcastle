// 🖼️ ภาพทั่วไป
<Image
  src="/products/shoe.jpg"
  alt="รองเท้า"
  width={800}
  height={600}
  placeholder="blur"
  placeholderBlur="data:image/jpeg;base64,..."
/>

// ⚡ LCP / Priority
<Image
  src="/hero/banner.jpg"
  alt="Hero"
  priority
  format="auto"
  cropMode="smart"
  retry={3}
/>

// 📱 Responsive เต็มพื้นที่
<Image
  src="/card/background.webp"
  alt="Card"
  fittingType="fill"
  objectFit="cover"
  focalPoint={{ x: 0.5, y: 0.2 }}
  placeholder="skeleton"
/>
 
 
 
 
⚙️ Props ทั้งหมด
 
 ImageProps 
 
Prop Type Default คำอธิบาย 
 src   string  จำเป็น URL ภาพต้นฉบับ 
 alt   string  จำเป็น คำอธิบาย (Accessibility) 
 width/height   number  - ขนาดภาพ 
 fittingType   fill/fit   fit  เต็มพื้นที่หรือรักษาสัดส่วน 
 cropMode   fill/fit/smart   fill  โหมดครอป 
 focalPoint   {x:0-1,y:0-1}  - จุดศูนย์กลางความสนใจ 
 priority   boolean   false  โหลดก่อน (LCP) 
 placeholder   none/blur/skeleton   blur  ตัวแทนขณะโหลด 
 format   auto/avif/webp/jpg   auto  รูปแบบภาพ 
 loadingStrategy   lazy/eager   lazy  กลไกการโหลด 
 retry   number   2  จำนวนครั้งลองใหม่ 
 fallbackImages   string[]   []  ภาพสำรอง 
 
 
 
🧠 Cache Layer
 
ใช้งาน
 
ts
  
import { imageCache } from "@/features/shared/ui/image/cache";

// ตรวจสอบ
const entry = await imageCache.get("key");

// บันทึก
await imageCache.set("key", "data-url", { size: 12345 });

// สถิติ
console.log(imageCache.getStats());
 
 
คุณสมบัติ
 
- ลำดับชั้น: Memory (เร็ว) → IndexedDB (คงทน)
- TTL: 24 ชม.
- ขีดจำกัด: Memory 50MB, IDB 200MB
- LRU Eviction: ลบเก่าสุดเมื่อเต็ม
 
 
 
📊 Analytics & Telemetry
 
ดูสถิติ
 
ts
  
import { imageTracker } from "@/features/shared/ui/image/analytics";

// ดูสรุป
console.log(imageTracker.getStats());
// → { cacheHitRate: 0.92, avgLoadTimeMs: 120, ... }

// เพิ่ม Exporter
import { PrometheusExporter } from "./analytics/exporters/prometheus";
imageTracker.addExporter(PrometheusExporter);
 
 
Metrics ที่เก็บ
 
- ✅ Load Time (ms)
- ✅ Cache Hit/Miss/Stale
- ✅ Format (AVIF/WebP/JPG)
- ✅ Status (Loaded/Error)
- ✅ Retry Count
- ✅ LCP Candidate
- ✅ Size (bytes)
 
 
 
🔧 การกำหนดค่า
 
แก้ไขใน  constants.ts :
 
ts
  
// Image
export const IMAGE_DEFAULTS = { FORMAT: "auto", RETRY: 2 };

// Cache
export const CACHE_CONFIG = { MAX_MEMORY_SIZE: 50 * 1024 * 1024 };

// Analytics
export const ANALYTICS_CONFIG = { BATCH_SIZE: 20, FLUSH_INTERVAL: 5000 };
 
 
 
 
