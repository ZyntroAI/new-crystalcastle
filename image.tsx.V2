// Hero / LCP Image (Priority + AVIF Auto)
<Image
  src="/hero/main.jpg"
  alt="Hero Banner"
  width={1200}
  height={600}
  priority
  format="auto"
  placeholder="blur"
  placeholderBlur="data:image/jpeg;base64,..."
  cropMode="smart"
  retry={3}
  className="rounded-xl shadow-lg"
/>

// Responsive Fill (Card Background)
