ts
  
export type ImageStatus = "loading" | "loaded" | "error";
export type CacheStatus = "hit" | "miss" | "stale";

export interface ImageMetric {
  src: string;
  format: string;
  width?: number;
  height?: number;
  status: ImageStatus;
  cacheStatus: CacheStatus;
  loadTimeMs: number;
  decodedTimeMs?: number;
  sizeBytes: number;
  timestamp: number;
  retryCount: number;
  lcpCandidate: boolean;
}

export interface AggregatedStats {
  total: number;
  loaded: number;
  errors: number;
  cacheHitRate: number;
  avgLoadTimeMs: number;
  p95LoadTimeMs: number;
  totalBytes: number;
  byFormat: Record<string, { count: number; avgTime: number }>;
}

export interface Exporter {
  export(metrics: ImageMetric[]): void | Promise<void>;
  flush?(): void | Promise<void>;
}
 
 
