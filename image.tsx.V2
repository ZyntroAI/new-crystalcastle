1️⃣  types.ts  — สัญญาและประเภทข้อมูล
 
ts
  
export type ImageFormat = "auto" | "webp" | "avif" | "jpg";
export type PlaceholderType = "none" | "blur" | "skeleton";
export type LoadingStrategy = "lazy" | "eager";
export type FittingType = "fill" | "fit";
export type CropMode = "fill" | "fit" | "smart";
export type LoadStatus = "idle" | "loading" | "loaded" | "error";

export interface FocalPoint { x: number; y: number }

export interface ImageProps {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  fittingType?: FittingType;
  cropMode?: CropMode;
  focalPoint?: FocalPoint;
  aspectRatio?: string | number;

  priority?: boolean;
  placeholder?: PlaceholderType;
  placeholderBlur?: string;
  format?: ImageFormat;
  loadingStrategy?: LoadingStrategy;
  fallbackImages?: string[];
  retry?: number;
  retryDelay?: number;

  className?: string;
  containerClassName?: string;
  objectFit?: "contain" | "cover" | "fill" | "none";
  objectPosition?: string;

  onLoad?: () => void;
  onError?: (err: Error) => void;
  onStatusChange?: (status: LoadStatus) => void;
}

export interface UrlBuildOptions {
  format: ImageFormat;
  width?: number;
  quality?: number;
  focal?: FocalPoint;
  crop: CropMode;
}
 
 
