3️⃣  cache/base.ts 
 
ts
  
import type { CacheEntry } from "./types";

export abstract class BaseCacheStore {
  protected isExpired(entry: CacheEntry): boolean {
    return Date.now() - entry.createdAt > entry.ttl;
  }

  protected touchEntry(entry: CacheEntry): CacheEntry {
    return { ...entry, accessedAt: Date.now() };
  }
}
 
 
4️⃣  cache/memory-store.ts 
 
ts
  
import type { ICacheStore, CacheEntry } from "./types";
import { BaseCacheStore } from "./base";
import { CACHE_CONFIG } from "../constants";

export class MemoryCacheStore extends BaseCacheStore implements ICacheStore {
  readonly name = "memory";
  private store = new Map<string, CacheEntry>();

  async get(key: string): Promise<CacheEntry | null> {
    const entry = this.store.get(key);
    if (!entry) return null;
    if (this.isExpired(entry)) {
      this.store.delete(key);
      return null;
    }
    this.store.set(key, this.touchEntry(entry));
    return entry;
  }

  async set(key: string, entry: Omit<CacheEntry, "createdAt" | "accessedAt">): Promise<void> {
    this.evictIfNeeded(entry.size);
    const newEntry: CacheEntry = {
      ...entry,
      createdAt: Date.now(),
      accessedAt: Date.now(),
    };
    this.store.set(key, newEntry);
  }

  async delete(key: string): Promise<boolean> {
    return this.store.delete(key);
  }

  async has(key: string): Promise<boolean> {
    const entry = await this.get(key);
    return !!entry;
  }

  async keys(): Promise<string[]> {
    return Array.from(this.store.keys());
  }

  async clear(): Promise<void> {
    this.store.clear();
  }

  async getSize(): Promise<number> {
    let total = 0;
    this.store.forEach(e => total += e.size);
    return total;
  }

  private async evictIfNeeded(additional: number): Promise<void> {
    const currentSize = await this.getSize();
    if (currentSize + additional <= CACHE_CONFIG.MAX_MEMORY_SIZE) return;

    const entries = Array.from(this.store.values())
      .sort((a, b) => a.accessedAt - b.accessedAt); // LRU

    let freed = 0;
    for (const entry of entries) {
      freed += entry.size;
      this.store.delete(entry.key);
      if (currentSize + additional - freed <= CACHE_CONFIG.MAX_MEMORY_SIZE * CACHE_CONFIG.EVICTION_THRESHOLD) break;
    }
  }
}
 
 
