5️⃣  analytics/exporters/prometheus.ts 
 
ts
  
import type { Exporter } from "../types";
import { METRIC_NAMES } from "../constants";

export const PrometheusExporter: Exporter = {
  export(metrics) {
    const lines: string[] = [];
    metrics.forEach(m => {
      const labels = `format="${m.format}",status="${m.status}",cache="${m.cacheStatus}"`;
      lines.push(`${METRIC_NAMES.LOAD_TIME}{${labels}} ${m.loadTimeMs}`);
      lines.push(`${METRIC_NAMES.SIZE}{${labels}} ${m.sizeBytes}`);
    });
    return lines.join("\n");
  }
};
 
 
