ts
  
import type { ImageMetric, AggregatedStats } from "./types";

export class MetricsStore {
  private buffer: ImageMetric[] = [];
  private listeners: ((metrics: ImageMetric[]) => void)[] = [];

  record(metric: ImageMetric): void {
    this.buffer.push(metric);
    this.notify();
  }

  subscribe(cb: (m: ImageMetric[]) => void): () => void {
    this.listeners.push(cb);
    return () => { this.listeners = this.listeners.filter(l => l !== cb); };
  }

  private notify(): void {
    this.listeners.forEach(cb => cb([...this.buffer]));
  }

  flush(): ImageMetric[] {
    const data = [...this.buffer];
    this.buffer = [];
    return data;
  }

  getStats(): AggregatedStats {
    const total = this.buffer.length;
    const loaded = this.buffer.filter(m => m.status === "loaded").length;
    const errors = this.buffer.filter(m => m.status === "error").length;
    const hits = this.buffer.filter(m => m.cacheStatus === "hit").length;
    const times = this.buffer.map(m => m.loadTimeMs).sort((a, b) => a - b);
    const byFormat: AggregatedStats["byFormat"] = {};

    for (const m of this.buffer) {
      if (!byFormat[m.format]) byFormat[m.format] = { count: 0, avgTime: 0 };
      byFormat[m.format].count++;
      byFormat[m.format].avgTime += m.loadTimeMs;
    }
    Object.values(byFormat).forEach(f => { f.avgTime /= f.count; });

    return {
      total, loaded, errors,
      cacheHitRate: total ? hits / total : 0,
      avgLoadTimeMs: times.length ? times.reduce((a, b) => a + b, 0) / times.length : 0,
      p95LoadTimeMs: times[Math.floor(times.length * 0.95)] || 0,
      totalBytes: this.buffer.reduce((s, m) => s + m.sizeBytes, 0),
      byFormat,
    };
  }
}
 
 
