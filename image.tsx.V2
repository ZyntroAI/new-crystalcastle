ts
  
import type { ImageMetric, Exporter } from "./types";
import { MetricsStore } from "./metrics";
import { ANALYTICS_CONFIG } from "./constants";
import { ConsoleExporter } from "./exporters/console";

export class ImageTracker {
  private static instance: ImageTracker;
  private store = new MetricsStore();
  private exporters: Exporter[] = [];
  private timer?: ReturnType<typeof setInterval>;

  private constructor() {
    if (!ANALYTICS_CONFIG.ENABLED) return;
    this.exporters.push(ConsoleExporter);
    this.startAutoFlush();
  }

  static getInstance(): ImageTracker {
    if (!ImageTracker.instance) ImageTracker.instance = new ImageTracker();
    return ImageTracker.instance;
  }

  addExporter(e: Exporter): void { this.exporters.push(e); }

  track(metric: Omit<ImageMetric, "timestamp">): void {
    if (Math.random() > ANALYTICS_CONFIG.SAMPLE_RATE) return;
    this.store.record({ ...metric, timestamp: Date.now() });
    if (this.store["buffer"].length >= ANALYTICS_CONFIG.BATCH_SIZE) this.flush();
  }

  private startAutoFlush(): void {
    this.timer = setInterval(() => this.flush(), ANALYTICS_CONFIG.FLUSH_INTERVAL);
  }

  async flush(): Promise<void> {
    const data = this.store.flush();
    await Promise.all(this.exporters.map(e => Promise.resolve(e.export(data))));
  }

  getStats() { return this.store.getStats(); }
  destroy(): void { if (this.timer) clearInterval(this.timer); }
}

export const imageTracker = ImageTracker.getInstance();
 
 
