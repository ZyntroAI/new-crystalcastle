1️⃣  cache/types.ts 
 
ts
  
export interface CacheEntry {
  key: string;
  data: string; // Base64 / Blob URL
  etag?: string;
  lastModified?: string;
  size: number;
  createdAt: number;
  accessedAt: number;
  ttl: number;
}

export interface CacheStats {
  hits: number;
  misses: number;
  size: number;
  count: number;
}

export interface ICacheStore {
  name: string;
  get(key: string): Promise<CacheEntry | null>;
  set(key: string, entry: Omit<CacheEntry, "createdAt" | "accessedAt">): Promise<void>;
  delete(key: string): Promise<boolean>;
  has(key: string): Promise<boolean>;
  keys(): Promise<string[]>;
  clear(): Promise<void>;
  getSize(): Promise<number>;
}

export type CacheTier = "memory" | "indexedDB";
 
 
