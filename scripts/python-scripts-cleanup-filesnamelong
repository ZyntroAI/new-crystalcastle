📝 Cleanup Scripts Collection

Script 1: Find Long Filenames (Python)

python
#!/usr/bin/env python3
"""
find_long_filenames.py
ค้นหาไฟล์ที่มีชื่อหรือเส้นทางยาวเกินกว่าที่ OS รองรับ
"""

import os
import sys
from pathlib import Path

def find_long_paths(root_dir=".", max_length=255, output_file="long_files_report.txt"):
    """
    ค้นหาไฟล์ที่มีชื่อเส้นทางยาวเกินไป
    
    Args:
        root_dir: ไดเรกทอรี่ที่ต้องการค้นหา (default: current directory)
        max_length: ความยาวสูงสุดที่อนุญาต (default: 255)
        output_file: ไฟล์ output สำหรับบันทึกผลลัพธ์
    """
    
    long_files = []
    long_dirs = []
    
    print(f"🔍 ค้นหาไฟล์ที่มีชื่อยาวเกิน {max_length} ตัวอักษร...")
    print(f"📁 ที่มา: {root_dir}\n")
    
    for dirpath, dirnames, filenames in os.walk(root_dir):
        # ตรวจสอบ directory names
        for dirname in dirnames:
            full_path = os.path.join(dirpath, dirname)
            if len(full_path) > max_length:
                long_dirs.append({
                    'path': full_path,
                    'length': len(full_path),
                    'type': 'directory'
                })
        
        # ตรวจสอบ file names
        for filename in filenames:
            full_path = os.path.join(dirpath, filename)
            if len(full_path) > max_length:
                long_files.append({
                    'path': full_path,
                    'basename': filename,
                    'length': len(full_path),
                    'type': 'file'
                })
    
    # แสดงผล
    all_long = long_files + long_dirs
    
    if all_long:
        print(f"⚠️  พบไฟล์/โฟลเดอร์ที่มีชื่อยาวเกินไป: {len(all_long)} รายการ\n")
        print("=" * 100)
        
        for item in sorted(all_long, key=lambda x: x['length'], reverse=True):
            print(f"\n📄 {item['type'].upper()}")
            print(f"   Path: {item['path']}")
            print(f"   Length: {item['length']} characters")
            print(f"   Basename: {item.get('basename', item['path'].split(os.sep)[-1])}")
        
        # บันทึกลงไฟล์
        with open(output_file, 'w', encoding='utf-8') as f:
            f.write(f"Report: Long Filename Detection\n")
            f.write(f"Generated: {os.path.getsize(root_dir)}\n")
            f.write(f"Total findings: {len(all_long)}\n")
            f.write("=" * 100 + "\n\n")
            
            for item in sorted(all_long, key=lambda x: x['length'], reverse=True):
                f.write(f"\n{item['type'].upper()}\n")
                f.write(f"Path: {item['path']}\n")
                f.write(f"Length: {item['length']}\n")
        
        print(f"\n✅ ผลลัพธ์ถูกบันทึกไว้ที่: {output_file}\n")
        return all_long
    else:
        print("✅ ไม่พบไฟล์ที่มีชื่อยาวเกินไป\n")
        return []

if __name__ == "__main__":
    root_path = sys.argv[1] if len(sys.argv) > 1 else "."
    max_len = int(sys.argv[2]) if len(sys.argv) > 2 else 255
    
    find_long_paths(root_path, max_len)


