Script 3: Bash Script for Git Fix

bash
#!/bin/bash
# fix_git_longpaths.sh
# แก้ปัญหา long filename ใน Git repository

set -e

echo "🔧 Git Long Paths Configuration Fixer"
echo "======================================"
echo ""

# ตรวจสอบว่าอยู่ใน git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "❌ ไม่อยู่ใน Git repository"
    exit 1
fi

echo "✅ Git repository detected"
echo ""

# 1. Enable long paths
echo "1️⃣  Enabling core.longpaths..."
git config core.longpaths true
echo "   ✅ git config core.longpaths = true"
echo ""

# 2. สร้าง report ไฟล์ที่มีชื่อยาว
echo "2️⃣  Scanning for long filenames..."
LONG_FILES=$`(git ls-files --full-name | awk '{ if (length(`$0) > 255) print $`0 }')

if [ -z "`$LONG_FILES" ]; then
    echo "   ✅ ไม่พบไฟล์ที่มีชื่อเส้นทางยาวเกิน 255 ตัวอักษร"
else
    echo "   ⚠️  พบไฟล์ที่มีชื่อเส้นทางยาว:"
    echo "$`LONG_FILES" | nl
    echo ""
    echo "   💡 ต้องเปลี่ยนชื่อไฟล์เหล่านี้ด้วย rename/cleanup script"
fi

echo ""

# 3. Check git status
echo "3️⃣  Git status:"
git status --short || true
echo ""

# 4. สร้าง .gitattributes
echo "4️⃣  Creating .gitattributes for UTF-8 handling..."
cat >> .gitattributes << 'EOF'
# UTF-8 handling
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
EOF
echo "   ✅ .gitattributes created"
echo ""

echo "5️⃣  Done! Summary:"
echo "   ✅ Long paths enabled"
echo "   ✅ .gitattributes configured"
echo "   💡 Next: Use cleanup script to rename long filenames"
echo ""


