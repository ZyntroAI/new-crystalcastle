Script 4: GitHub Actions Workflow Fix

yaml
# .github/workflows/fix-long-paths.yml
name: Fix Long Filenames

on:
  workflow_dispatch:  # Manual trigger

jobs:
  scan-and-fix:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
      
      - name: Setup Git Config
        run: |
          git config --global core.longpaths true
          git config --global user.email "automation@github.com"
          git config --global user.name "GitHub Automation"
      
      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'
      
      - name: Create cleanup script
        run: |
          cat > cleanup.py << 'PYTHON_EOF'
          import os
          import sys
          from pathlib import Path
          
          def find_long_files(root_dir=".", max_length=255):
              long_files = []
              for dirpath, dirnames, filenames in os.walk(root_dir):
                  for filename in filenames:
                      full_path = os.path.join(dirpath, filename)
                      if len(full_path) > max_length or len(filename) > 100:
                          long_files.append((full_path, len(full_path)))
              return long_files
          
          long_files = find_long_files()
          if long_files:
              print(f"Found {len(long_files)} long filenames:")
              for path, length in sorted(long_files, key=lambda x: x[1], reverse=True):
                  print(f"  {path} ({length} chars)")
          else:
              print("No long filenames found!")
          
          PYTHON_EOF
      
      - name: Scan for long filenames
        run: python cleanup.py
      
      - name: List problematic files
        run: |
          echo "Files with long paths:"
          git ls-files --full-name | awk '{ if (length(`$0) > 200) print "  " $`0 " (" length(`$0) " chars)" }' | head -20
      
      - name: Create summary
        run: |
          echo "## 📊 Long Filename Report" >> $`GITHUB_STEP_SUMMARY
          echo "" >> `$GITHUB_STEP_SUMMARY
          echo "### Scan Results" >> $`GITHUB_STEP_SUMMARY
          echo "" >> `$GITHUB_STEP_SUMMARY
          echo "\`\`\`" >> $`GITHUB_STEP_SUMMARY
          git ls-files --full-name | awk '{ if (length(`$0) > 200) print "  " $`0 " (" length(`$0) " chars)" }' | head -20 >> $`GITHUB_STEP_SUMMARY
          echo "\`\`\`" >> `$GITHUB_STEP_SUMMARY


