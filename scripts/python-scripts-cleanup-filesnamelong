🚀 วิธีใช้ Scripts

Step 1: Download Scripts

bash
# ดาวน์โหลดไปยัง repo
cd 1napz/crystalcastle

# สร้างไดเรกทอรี่ scripts
mkdir -p scripts

# Copy scripts ลงไป
cat > scripts/find_long_filenames.py << 'EOF'
# [paste Script 1 here]
EOF

cat > scripts/cleanup_long_filenames.py << 'EOF'
# [paste Script 2 here]
EOF

cat > scripts/fix_git_longpaths.sh << 'EOF'
# [paste Script 3 here]
EOF

chmod +x scripts/*.py scripts/*.sh


Step 2: Run Scan (Dry Run)

bash
# ค้นหาไฟล์ที่มีชื่อยาว
python3 scripts/find_long_filenames.py docs/

# ดูรายงาน
cat long_files_report.txt


Step 3: Cleanup (Dry Run First)

bash
# ทดลอง rename ก่อน (ไม่ได้เปลี่ยนจริง)
python3 scripts/cleanup_long_filenames.py \
    --root=docs \
    --action=rename \
    --max-length=200

# ถ้าดูดี แล้ว apply จริง
python3 scripts/cleanup_long_filenames.py \
    --root=docs \
    --action=rename \
    --max-length=200 \
    --no-dry-run


Step 4: Fix Git Config

bash
# แก้ไข Git configuration
bash scripts/fix_git_longpaths.sh


Step 5: Commit Changes

bash
git add -A
git commit -m "fix: rename long filenames and enable git longpaths support"
git push origin main


