Script 2: Rename/Cleanup Tool (Python)

python
#!/usr/bin/env python3
"""
cleanup_long_filenames.py
เปลี่ยนชื่อหรือลบไฟล์ที่มีชื่อยาวเกินไป
"""

import os
import sys
import shutil
import hashlib
from pathlib import Path
from datetime import datetime

class FilenameCleanup:
    def __init__(self, root_dir=".", max_length=200, dry_run=True):
        self.root_dir = root_dir
        self.max_length = max_length
        self.dry_run = dry_run
        self.changes = []
        
    def generate_short_name(self, filepath, max_length=50):
        """สร้างชื่อไฟล์ที่สั้นลง"""
        path_obj = Path(filepath)
        basename = path_obj.name
        stem = path_obj.stem  # ชื่อไฟล์ไม่นับ extension
        suffix = path_obj.suffix  # extension
        
        if len(basename) <= self.max_length:
            return basename
        
        # สร้างชื่อสั้นด้วย hash
        file_hash = hashlib.md5(basename.encode()).hexdigest()[:8]
        
        # ตัดชื่อเหลือเพียงส่วนแรก + hash
        max_stem_length = max_length - len(suffix) - len(file_hash) - 2
        if max_stem_length < 10:
            max_stem_length = 10
        
        short_stem = stem[:max_stem_length]
        short_name = f"{short_stem}_{file_hash}{suffix}"
        
        return short_name
    
    def shorten_path(self, filepath):
        """ตัดชื่อเส้นทางให้สั้นลง"""
        path_obj = Path(filepath)
        
        # ถ้าเส้นทางยาวเกิน max_length
        if len(str(path_obj)) > self.max_length:
            parts = path_obj.parts
            
            # ตัด directory names ให้สั้น
            shortened_parts = []
            for part in parts:
                if len(part) > 30:
                    # ตัดโฟลเดอร์ชื่อยาว
                    short_part = part[:15] + "_" + hashlib.md5(part.encode()).hexdigest()[:6]
                    shortened_parts.append(short_part)
                else:
                    shortened_parts.append(part)
            
            new_path = os.path.join(*shortened_parts)
            return new_path
        
        return filepath
    
    def cleanup(self, action="rename"):
        """
        ล้างข้อมูล ชื่อไฟล์ยาว
        
        Args:
            action: "rename" (เปลี่ยนชื่อ) หรือ "remove" (ลบไฟล์)
        """
        
        print(f"{'[DRY RUN]' if self.dry_run else '[ACTUAL RUN]'} Cleaning up long filenames...")
        print(f"Action: {action}")
        print(f"Max length: {self.max_length}\n")
        
        for dirpath, dirnames, filenames in os.walk(self.root_dir):
            for filename in filenames:
                old_path = os.path.join(dirpath, filename)
                
                if len(old_path) > self.max_length or len(filename) > 100:
                    if action == "rename":
                        new_filename = self.generate_short_name(filename)
                        new_path = os.path.join(dirpath, new_filename)
                        
                        change = {
                            'old': old_path,
                            'new': new_path,
                            'old_length': len(old_path),
                            'new_length': len(new_path),
                            'action': 'rename'
                        }
                        self.changes.append(change)
                        
                        print(f"📝 RENAME")
                        print(f"   From: {old_path} ({len(old_path)} chars)")
                        print(f"   To:   {new_path} ({len(new_path)} chars)\n")
                        
                        if not self.dry_run:
                            try:
                                shutil.move(old_path, new_path)
                                print(f"   ✅ เปลี่ยนชื่อสำเร็จ\n")
                            except Exception as e:
                                print(f"   ❌ ข้อผิดพลาด: {e}\n")
                    
                    elif action == "remove":
                        change = {
                            'path': old_path,
                            'length': len(old_path),
                            'action': 'remove'
                        }
                        self.changes.append(change)
                        
                        print(f"🗑️  DELETE")
                        print(f"   Path: {old_path} ({len(old_path)} chars)\n")
                        
                        if not self.dry_run:
                            try:
                                os.remove(old_path)
                                print(f"   ✅ ลบไฟล์สำเร็จ\n")
                            except Exception as e:
                                print(f"   ❌ ข้อผิดพลาด: {e}\n")
        
        # สรุปผล
        self._print_summary()
    
    def _print_summary(self):
        """แสดงสรุปผล"""
        if not self.changes:
            print("ℹ️  ไม่มีไฟล์ที่ต้องการจัดการ\n")
            return
        
        print("=" * 100)
        print(f"📊 SUMMARY: {len(self.changes)} files affected\n")
        
        if self.dry_run:
            print("⚠️  [


