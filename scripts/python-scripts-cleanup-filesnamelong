        <h3>Script 1: Find Long Filenames (`find_long_filenames.py`)</h3>
        <pre><code class="language-python">#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
===============================================================================
Script Name   : find_long_filenames.py
Description   : Audits directory trees to locate paths exceeding OS threshold limits.
License       : MIT License
===============================================================================
"""

import os
import sys
import logging
import argparse
from pathlib import Path

# Configure Structured Logging
logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")

def find_long_paths(root_dir: str, max_length: int, output_file: str) -> list:
    long_entries = []
    root_path = Path(root_dir).resolve()
    
    logging.info(f"Scanning target: {root_path} (Threshold: >{max_length} chars)")

    for dirpath, dirnames, filenames in os.walk(root_path):
        for name in dirnames + filenames:
            full_path = os.path.join(dirpath, name)
            if len(full_path) > max_length:
                entry_type = "DIRECTORY" if os.path.isdir(full_path) else "FILE"
                long_entries.append({'path': full_path, 'length': len(full_path), 'type': entry_type})

    long_entries.sort(key=lambda x: x['length'], reverse=True)

    if long_entries:
        logging.warning(f"Detected {len(long_entries)} path violation(s).")
        with open(output_file, 'w', encoding='utf-8') as f:
            f.write(f"LONG FILENAME AUDIT REPORT\nRoot: {root_path}\nTotal Violations: {len(long_entries)}\n{'='*80}\n\n")
            for item in long_entries:
                f.write(f"[{item['type']}] ({item['length']} chars) {item['path']}\n")
        logging.info(f"Audit log successfully generated at: {output_file}")
    else:
        logging.info("No long filename violations detected.")

    return long_entries

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Audit directory trees for long filename path violations.")
    parser.add_argument("--root", default=".", help="Target root directory path")
    parser.add_argument("--max-length", type=int, default=255, help="Maximum allowed file path character length")
    parser.add_argument("--output", default="long_files_report.txt", help="Output audit report file name")
    
    args = parser.parse_args()
    sys.exit(0 if not find_long_paths(args.root, args.max_length, args.output) else 1)</code></pre>

        <h3>Script 2: Rename / Cleanup Tool (`cleanup_long_filenames.py`)</h3>
        <pre><code class="language-python">#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
===============================================================================
Script Name   : cleanup_long_filenames.py
Description   : Automatically truncates or removes path-violating filenames.
License       : MIT License
===============================================================================
"""

import os
import sys
import shutil
import hashlib
import logging
import argparse
from pathlib import Path

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")

class FilenameCleaner:
    def __init__(self, root_dir: str, max_length: int, dry_run: bool = True):
        self.root_dir = Path(root_dir).resolve()
        self.max_length = max_length
        self.dry_run = dry_run

    def _shorten_filename(self, filename: str) -> str:
        stem, suffix = os.path.splitext(filename)
        file_hash = hashlib.md5(filename.encode('utf-8')).hexdigest()[:8]
        allowed_stem_len = max(10, 40 - len(suffix) - len(file_hash) - 2)
        return f"{stem[:allowed_stem_len]}_{file_hash}{suffix}"

    def execute(self, action: str = "rename"):
        mode_str = "[DRY-RUN]" if self.dry_run else "[LIVE EXECUTION]"
        logging.info(f"{mode_str} Starting remediation. Action={action}, Max Length={self.max_length}")

        for dirpath, _, filenames in os.walk(self.root_dir):
            for filename in filenames:
                old_path = os.path.join(dirpath, filename)
                if len(old_path) > self.max_length:
                    if action == "rename":
                        new_filename = self._shorten_filename(filename)
                        new_path = os.path.join(dirpath, new_filename)
                        logging.info(f"RENAME: {old_path} -> {new_filename}")
                        if not self.dry_run:
                            shutil.move(old_path, new_path)
                    elif action == "remove":
                        logging.warning(f"REMOVE: {old_path}")
                        if not self.dry_run:
                            os.remove(old_path)

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Remediate long file paths safely.")
    parser.add_argument("--root", default=".", help="Root directory path")
    parser.add_argument("--max-length", type=int, default=200, help="Max length threshold")
    parser.add_argument("--action", choices=["rename", "remove"], default="rename", help="Action strategy")
    parser.add_argument("--no-dry-run", action="store_true", help="Execute real file changes")
    
    args = parser.parse_args()
    cleaner = FilenameCleaner(args.root, args.max_length, dry_run=not args.no_dry_run)
    cleaner.execute(args.action)</code></pre>

        <h3>Script 3: Git Long Paths Fixer (`fix_git_longpaths.sh`)</h3>
        <pre><code class="language-bash">#!/usr/bin/env bash
# ===============================================================================
# Script Name   : fix_git_longpaths.sh
# Description   : Configure Git core settings for long path support across platforms.
# License       : MIT License
# ===============================================================================

set -euo pipefail

echo "🔧 Configuring Git Core Engine..."

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "❌ Error: Current directory is not a valid Git repository." >&2
    exit 1
fi

# Enable core.longpaths globally and locally
git config core.longpaths true
echo "✅ Core longpaths enabled."

# Update .gitattributes
GITATTR_FILE=".gitattributes"
if [ ! -f "$GITATTR_FILE" ]; then
    touch "$GITATTR_FILE"
fi

cat << 'EOF' >> "$GITATTR_FILE"
# Standardized Line Endings & Encoding
* text=auto eol=lf
*.py text eol=lf
*.sh text eol=lf
EOF

echo "✅ Standardized .gitattributes file successfully updated."</code></pre>
