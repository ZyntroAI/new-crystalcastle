<script>
function generateCommand() {
    const root = document.getElementById('target-dir').value || '.';
    const maxLen = document.getElementById('max-len').value || '200';
    const action = document.getElementById('action-type').value;
    const mode = document.getElementById('execution-mode').value;
    
    let cmd = `python3 scripts/cleanup_long_filenames.py --root ${root} --max-length ${maxLen} --action ${action}`;
    if (mode === 'apply') {
        cmd += ' --no-dry-run';
    } else {
        cmd += ' --dry-run';
    }
    
    document.getElementById('output-command').textContent = cmd;
}
</script>

