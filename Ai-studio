package main

import (
	"context"
	"flag"
	"fmt"
	"log"
	"os"
	"time"

	"google.golang.org/genai"
)

func main() {
	model := flag.String("model", "", "ชื่อโมเดล")
	timeout := flag.Duration("timeout", 30*time.Second, "หมดเวลา")
	flag.Parse()

	apiKey := os.Getenv("GEMINI_API_KEY")
	if *model == "" || apiKey == "" {
		log.Fatal("ต้องตั้งค่า --model และ GEMINI_API_KEY")
	}

	ctx, cancel := context.WithTimeout(context.Background(), *timeout)
	defer cancel()

	client, _ := genai.NewClient(ctx, &genai.ClientConfig{
		Backend: genai.BackendGeminiAPI,
		APIKey:  apiKey,
	})

	prompt := os.Getenv("PROMPT")
	if prompt == "" {
		prompt = "สวัสดี ช่วยแนะนำตัวหน่อย"
	}

	result, err := client.Models.GenerateContent(ctx, *model,
		[]*genai.Content{{Role: "user", Parts: []*genai.Part{{Text: prompt}}}},
		&genai.GenerateContentConfig{})

	if err != nil {
		log.Fatal(err)
	}
	fmt.Println(result.Text())
}
