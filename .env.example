# ──────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────
APP_NAME="New Crystal Castle"
APP_ENV=production
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api
API_URL=https://your-domain.com/api

# ──────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ──────────────────────────────────────────────
API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx
API_SECRET=sk_xxxxxxxxxxxxxxxxxxxxxxxx

JWT_SECRET=changeme_very_long_random_secret_here
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=changeme_very_long_random_refresh_secret_here
REFRESH_TOKEN_EXPIRES_IN=7d
DOLA_JWT_SECRET=changeme_dola_jwt_secret_here

# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/ccastle
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crystalcastle
DB_USER=db_user
DB_PASSWORD=changeme_db_password

# ──────────────────────────────────────────────
# CACHING
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# STORAGE (S3-compatible)
# ──────────────────────────────────────────────
STORAGE_PROVIDER=s3
STORAGE_BUCKET=your-bucket-name
STORAGE_REGION=ap-southeast-1
STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
STORAGE_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXX
STORAGE_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# AI / LLM INTEGRATION
# ──────────────────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=gpt-4o

# ──────────────────────────────────────────────
# SUPABASE
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────────
# EMAIL / SMTP
# ──────────────────────────────────────────────
SMTP_HOST=smtp.your-email.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASSWORD=changeme_smtp_password
SMTP_FROM=noreply@your-domain.com
APP_URL=https://your-domain.com

EMAIL_VERIFICATION_SECRET=changeme_email_verification_secret
PASSWORD_RESET_SECRET=changeme_password_reset_secret

# ──────────────────────────────────────────────
# SERVICES & INTEGRATIONS
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxxxxx
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/project-id
OBSIDIAN_TOKEN=obs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# SECURITY & RATE LIMITING
# ──────────────────────────────────────────────
CORS_ORIGIN=https://your-domain.com
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Le-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
RECAPTCHA_SECRET_KEY=6Le-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ──────────────────────────────────────────────
# CI / DEPLOYMENT
# ──────────────────────────────────────────────
CI=false
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REGISTRY=ghcr.io
IMAGE_NAME=zyntroai/crystalcastle
IMAGE_TAG=latest

# ──────────────────────────────────────────────
# OBSERVABILITY
# ──────────────────────────────────────────────
LOG_LEVEL=info

ได้ครับ นี่คือตัวอย่าง **`.env.example` ที่กรอกค่าตัวอย่างครบถ้วนสำหรับใช้เป็น Template** (ไม่ใช่ค่าจริงสำหรับ Production)

```env
###############################################################################
# Application
###############################################################################

APP_NAME=CrystalCastleX
APP_ENV=production
NODE_ENV=production

NEXT_PUBLIC_APP_URL=https://app.crystalcastlex.com
NEXT_PUBLIC_API_URL=https://api.crystalcastlex.com

###############################################################################
# API
###############################################################################

API_URL=http://backend:8000
API_KEY=sample-api-key-123456789

###############################################################################
# Database (PostgreSQL)
###############################################################################

DATABASE_URL=postgresql://crystal_user:StrongPassword123@postgres:5432/crystalcastlex

DB_HOST=postgres
DB_PORT=5432
DB_NAME=crystalcastlex
DB_USER=crystal_user
DB_PASSWORD=StrongPassword123

###############################################################################
# Redis
###############################################################################

REDIS_URL=redis://redis:6379

###############################################################################
# Authentication
###############################################################################

JWT_SECRET=replace-with-64-character-secret-key
JWT_EXPIRES_IN=7d

REFRESH_TOKEN_SECRET=replace-with-another-64-character-secret
REFRESH_TOKEN_EXPIRES_IN=30d

###############################################################################
# Storage (AWS S3 / MinIO / Cloudflare R2)
###############################################################################

STORAGE_PROVIDER=s3

STORAGE_BUCKET=crystalcastlex-prod
STORAGE_REGION=ap-southeast-1

STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com

STORAGE_ACCESS_KEY_ID=EXAMPLEACCESSKEY123
STORAGE_SECRET_ACCESS_KEY=EXAMPLESECRETKEY456

###############################################################################
# AI
###############################################################################

AI_PROVIDER=openai

AI_API_KEY=sk-example-key
AI_MODEL=gpt-4.1-mini

###############################################################################
# Monitoring
###############################################################################

SENTRY_DSN=https://example@sentry.io/12345
LOG_LEVEL=info

###############################################################################
# Notifications
###############################################################################

TELEGRAM_BOT_TOKEN=123456789:AAExampleBotToken
TELEGRAM_CHAT_ID=-1001234567890

###############################################################################
# Email
###############################################################################

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USER=noreply@crystalcastlex.com
SMTP_PASSWORD=example-password

SMTP_FROM=noreply@crystalcastlex.com

###############################################################################
# Security
###############################################################################

CORS_ORIGIN=https://app.crystalcastlex.com

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

###############################################################################
# Docker
###############################################################################

REGISTRY=ghcr.io/crystalcastlex

IMAGE_NAME=crystalcastlex
IMAGE_TAG=latest

###############################################################################
# Build / CI
###############################################################################

CI=true

###############################################################################
# GitHub Actions
###############################################################################

GH_TOKEN=${{ secrets.GITHUB_PAT }}
```

### สำหรับ Production จริง ควรเปลี่ยนค่าเหล่านี้ทันที

```env
JWT_SECRET=
REFRESH_TOKEN_SECRET=
DB_PASSWORD=
API_KEY=
AI_API_KEY=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
```

### สร้าง JWT Secret แบบปลอดภัย

```bash
openssl rand -hex 64
```

จะได้ตัวอย่างประมาณ

```env
JWT_SECRET=9dcd0134ce7018f68ecaa6a8c42ccbb4...
```

โครงสร้างนี้พร้อมใช้งานกับ:
- Next.js
- Node.js / NestJS / Express
- PostgreSQL
- Redis
- Docker Compose
- GitHub Actions
- AWS S3 / MinIO / Cloudflare R2
- OpenAI API
- Telegram Bot
- Sentry Monitoring

โดยถือเป็น Template ระดับ Production ที่ค่อนข้างครบสำหรับโปรเจกต์ Full Stack ทั่วไปครับ।

# .env — KEEP SECURE, NEVER COMMIT
API_SECRET=4a8f9c2d7e1b3f5a9c8e7d6b5f4a3e2d1c0f9a8b7c6d5e4f3a2b1c9d8e7f6a5b
OBSIDIAN_TOKEN=4a8f9c2d7e1b3f5a9c8e7d6b5f4a3e2d1c0f9a8b7c6d5e4f3a2b1c9d8e7f6a5b
DOLA_JWT_SECRET=4a8f9c2d7e1b3f5a9c8e7d6b5f4a3e2d1c0f9a8b7c6d5e4f3a2b1c9d8e7f6a5b



# Public (browser-safe)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Le_xxxxxxxxxxxxxxxxxx

# Private (server-only)
RECAPTCHA_SECRET_KEY=6Leyyyyyyyyyyyyyyyyyyyyyyy


env:
  VERCEL_AUTOMATION_BYPASS_SECRET: ${{ secrets.VERCEL_AUTOMATION_BYPASS_SECRET }}


NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ======================================
# EMAIL ATTACHMENT MONITOR
# ======================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
EMAIL_CHECK_INTERVAL=30
EMAIL_WATCH_FOLDER=INBOX
EMAIL_PROCESSED_FOLDER=Processed
EMAIL_ERROR_FOLDER=Errors
EMAIL_MAX_SIZE_MB=50

