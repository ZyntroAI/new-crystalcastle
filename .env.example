# ──────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────
APP_NAME="New Crystal Castle"
APP_ENV=production
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api
API_URL=https://your-domain.com/api

# ──────────────────────────────────────────────
# AUTHENTICATION & SECURITY
# ──────────────────────────────────────────────
API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx
API_SECRET=sk_xxxxxxxxxxxxxxxxxxxxxxxx

JWT_SECRET=changeme_very_long_random_secret_here
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=changeme_very_long_random_refresh_secret_here
REFRESH_TOKEN_EXPIRES_IN=7d
DOLA_JWT_SECRET=changeme_dola_jwt_secret_here

# ──────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/ccastle
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crystalcastle
DB_USER=db_user
DB_PASSWORD=changeme_db_password

# ──────────────────────────────────────────────
# CACHING
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────
# STORAGE (S3-compatible)
# ──────────────────────────────────────────────
STORAGE_PROVIDER=s3
STORAGE_BUCKET=your-bucket-name
STORAGE_REGION=ap-southeast-1
STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
STORAGE_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXX
STORAGE_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# AI / LLM INTEGRATION
# ──────────────────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=gpt-4o

# ──────────────────────────────────────────────
# SUPABASE
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ──────────────────────────────────────────────
# EMAIL / SMTP
# ──────────────────────────────────────────────
SMTP_HOST=smtp.your-email.com
SMTP_PORT=587
SMTP_USER=noreply@your-domain.com
SMTP_PASSWORD=changeme_smtp_password
SMTP_FROM=noreply@your-domain.com
APP_URL=https://your-domain.com

EMAIL_VERIFICATION_SECRET=changeme_email_verification_secret
PASSWORD_RESET_SECRET=changeme_password_reset_secret

# ──────────────────────────────────────────────
# SERVICES & INTEGRATIONS
# ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=xxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxxxxx
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/project-id
OBSIDIAN_TOKEN=obs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# SECURITY & RATE LIMITING
# ──────────────────────────────────────────────
CORS_ORIGIN=https://your-domain.com
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60000

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Le-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
RECAPTCHA_SECRET_KEY=6Le-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ──────────────────────────────────────────────
# CI / DEPLOYMENT
# ──────────────────────────────────────────────
CI=false
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REGISTRY=ghcr.io
IMAGE_NAME=zyntroai/crystalcastle
IMAGE_TAG=latest

# ──────────────────────────────────────────────
# OBSERVABILITY
# ──────────────────────────────────────────────
LOG_LEVEL=info
