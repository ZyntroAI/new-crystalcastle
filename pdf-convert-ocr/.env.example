# ============================================
# PDF Convert OCR — Email Attachment Auto-Processor
# Copy to `.env` and fill in real values.
# NEVER commit the real `.env`.
# ============================================
#   cp pdf-convert-ocr/.env.example pdf-convert-ocr/.env
# ============================================

# ---------- Default IMAP account ----------
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASS=changeme

# ---------- Polling / folders ----------
EMAIL_CHECK_INTERVAL=60
EMAIL_WATCH_FOLDER=INBOX
EMAIL_PROCESSED_FOLDER=Processed
EMAIL_ERROR_FOLDER=Errors
EMAIL_MAX_SIZE_MB=25

# ---------- Alternate IMAP account: Outlook ----------
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_USER=you@example.com
# IMAP_PASS=changeme

# ---------- Alternate IMAP account: self-hosted ----------
# IMAP_HOST=mail.example.com
# IMAP_PORT=993
# IMAP_USER=you@example.com
# IMAP_PASS=changeme

# ---------- SMTP (outbound alerts) ----------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=changeme
SMTP_FROM=you@example.com
ALERT_EMAIL=alerts@example.com

# ---------- Slack alerting ----------
SLACK_WEBHOOK=https://hooks.slack.com/services/REPLACE/ME
