# ======================================
# EMAIL ATTACHMENT MONITOR
# ======================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
EMAIL_CHECK_INTERVAL=30
EMAIL_WATCH_FOLDER=INBOX
EMAIL_PROCESSED_FOLDER=Processed
EMAIL_ERROR_FOLDER=Errors
EMAIL_MAX_SIZE_MB=50

Outlook/Office 365
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_USER=your-email@yourdomain.com
IMAP_PASS=your-password

Self-hosted
IMAP_HOST=mail.yourcompany.com
IMAP_PORT=993
IMAP_USER=ocr@yourcompany.com
IMAP_PASS=secure-password

# ======================================
# EMAIL ALERTS
# ======================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
ALERT_EMAIL=notify@yourdomain.com

# ======================================
# SLACK ALERTS
# ======================================
SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
