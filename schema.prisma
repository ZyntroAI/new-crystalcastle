datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Article {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  author      String
  publishedAt DateTime @default(now())
  tags        Tag[]    @relation("ArticleTags")
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  articles Article[] @relation("ArticleTags")
}
