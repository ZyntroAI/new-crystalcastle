<jobs>
name: CI

on:
  push:
    branches: [ main, master, dev, pure-agent, root, develop, crystalcastle-ai]
  pull_request:
    branches: [ main, master, dev, pure-agent, root, develop, crystalcastle-ai]
  workflow_dispatch:

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        node-version: [18, 20]
    env:
      CI: true

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Use Node.js ${{ matrix.node-version }}
        uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node-version }}
          cache: 'npm'
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - name: Install dependencies
        run: npm ci

      - name: Run lint
        run: npm run lint
        continue-on-error: false
      - name: Lint
        run: npm run lint --if-present

      - name: Type check
        if: exists('tsconfig.json')
        run: npm run typecheck
      - name: Typecheck
        run: npm run typecheck --if-present

      - name: Run tests
        run: npm test -- --runInBand --reporters=default
      - name: Test
        run: npm test --if-present

      - name: Build
        run: npm run build
  
      - name: Build
        run: npm run build --if-present

      - name: Upload build artifact
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: build-${{ matrix.node-version }}
          path: build || dist || .
</jobs>
