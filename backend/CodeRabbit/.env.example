# ============================================
# CodeRabbit integration — Vite client config
# Copy to `.env` and fill in real values.
# NEVER commit the real `.env`.
# ============================================
#   cp backend/CodeRabbit/.env.example backend/CodeRabbit/.env
#
# NOTE: every value here is inlined into the browser bundle at build
# time (VITE_*). Treat the token as PUBLIC — use a fine-grained,
# read-only, short-lived token scoped to a single repository.
# ============================================

VITE_GITHUB_TOKEN=your_github_token_here
VITE_DEFAULT_REPO=owner/repo
VITE_DEFAULT_PR=1
