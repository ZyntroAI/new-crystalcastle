    "dotenv": "^16.4.0",
    "express": "^4.19.2",
    "groq-sdk": "^0.5.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.0"
