import httpx
from datetime import datetime
from typing import Optional
import json
from pathlib import Path
from ..config import Config

CACHE_DIR = Path(__file__).parent.parent.parent / ".cache" / "wikipedia"
CACHE_DIR.mkdir(parents=True, exist_ok=True)
USER_AGENT = "ZyntroAI-Flask/1.0 (dev@zyntroai.com)"

def get_cache_key(title: str, lang: str) -> str:
    return f"{lang}:{title.lower().replace(' ', '_')}"

def load_cache(cache_key: str) -> Optional[dict]:
    cache_file = CACHE_DIR / f"{cache_key}.json"
    if cache_file.exists():
        data = json.loads(cache_file.read_text())
        return data
    return None

def save_cache(cache_key: str, data: dict, ttl: int = 86400):
    cache_file = CACHE_DIR / f"{cache_key}.json"
    cache_file.write_text(json.dumps(data, ensure_ascii=False, indent=2))

def fetch_wikipedia_article(title: str, lang: str = "en", use_cache: bool = True) -> dict:
    cache_key = get_cache_key(title, lang)
    
    if use_cache:
        cached = load_cache(cache_key)
        if cached:
            return cached

    api_url = f"https://{lang}.wikipedia.org/w/api.php"
    headers = {"User-Agent": USER_AGENT}
    params = {
        "action": "query", "format": "json", "titles": title,
        "prop": "extracts|info|revisions", "exintro": True, "explaintext": True,
        "inprop": "url", "rvprop": "ids", "rvlimit": 1,
    }

    resp = httpx.get(api_url, params=params, headers=headers, timeout=10.0)
    resp.raise_for_status()
    data = resp.json()

    pages = data["query"]["pages"]
    page = next(iter(pages.values()))
    if "missing" in page:
        raise ValueError(f"ไม่พบบทความ: {title}")

    result = {
        "title": page["title"],
        "summary": page["extract"][:800] + ("..." if len(page["extract"]) > 800 else ""),
        "full_url": page["fullurl"],
        "accessed_at": datetime.utcnow().isoformat(),
        "revision_id": str(page["revisions"][0]["revid"]),
        "license": "CC BY-SA 4.0",
        "lang": lang,
    }

    save_cache(cache_key, result)
    return result
 
 
