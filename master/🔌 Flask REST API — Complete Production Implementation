python  
from flask import request
from flask_jwt_extended import jwt_required
from . import bp
from app.utils.responses import success_response, error_response
from app.obsidian_sdk.client import ObsidianClient
from app.config import Config

def get_obsidian_client():
    if not Config.OBSIDIAN_API_KEY:
        raise RuntimeError("OBSIDIAN_API_KEY ยังไม่ได้ตั้งค่า")
    return ObsidianClient(
        api_url=Config.OBSIDIAN_API_URL,
        api_key=Config.OBSIDIAN_API_KEY,
        verify_ssl=Config.OBSIDIAN_VERIFY_SSL,
    )

@bp.route("/obsidian/status", methods=["GET"])
@jwt_required()
def obsidian_status():
    """ตรวจสอบการเชื่อมต่อ"""
    try:
        client = get_obsidian_client()
        info = client.health_check()
        return success_response(data={
            "connected": True,
            "vault_name": info.get("vaultName"),
            "api_url": Config.OBSIDIAN_API_URL,
        })
    except Exception as e:
        return success_response(data={
            "connected": False,
            "error": str(e),
            "api_url": Config.OBSIDIAN_API_URL,
        })

@bp.route("/obsidian/note/write", methods=["POST"])
@jwt_required()
def write_note():
    """สร้าง/อัปเดตโน้ต"""
    data = request.get_json()
    path = data.get("path")
    content = data.get("content")
    append = data.get("append", False)

    if not path or not content:
        return error_response("ต้องระบุ path และ content", status_code=400)

    try:
        client = get_obsidian_client()
        if append:
            result = client.append_to_note(path, content)
        else:
            result = client.write_note(path, content)
        return success_response(data={"path": path, "mode": "append" if append else "write"})
    except Exception as e:
        return error_response(f"เขียนไม่สำเร็จ: {str(e)}", status_code=500)

@bp.route("/obsidian/note/read", methods=["GET"])
@jwt_required()
def read_note():
    """อ่านโน้ต"""
    path = request.args.get("path")
    if not path:
        return error_response("ต้องระบุ path", status_code=400)

    try:
        client = get_obsidian_client()
        note = client.read_note(path)
        return success_response(data={"path": note.path, "content": note.content})
    except Exception as e:
        if "404" in str(e):
            return error_response("ไม่พบโน้ต", status_code=404)
        return error_response(f"อ่านไม่สำเร็จ: {str(e)}", status_code=500)
 
 
