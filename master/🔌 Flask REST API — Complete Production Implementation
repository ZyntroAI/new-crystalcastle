python  
"""
Obsidian Local REST API Client — ZyntroAI Flask
เอกสารอ้างอิง: https://github.com/coddingtonbear/obsidian-local-rest-api
"""
import httpx
from typing import Optional, List, Dict, Any
from dataclasses import dataclass

@dataclass
class Note:
    path: str
    content: str
    modified: Optional[str] = None

class ObsidianClient:
    def __init__(
        self,
        api_url: str = "https://127.0.0.1:27124",
        api_key: str = "",
        verify_ssl: bool = False,
    ):
        self.base_url = api_url.rstrip("/")
        self.api_key = api_key
        self.verify_ssl = verify_ssl
        self.headers = {
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "text/markdown",
        }

    def health_check(self) -> Dict[str, Any]:
        """ตรวจสอบการเชื่อมต่อ"""
        with httpx.Client(verify=self.verify_ssl, timeout=10.0) as client:
            resp = client.get(f"{self.base_url}/vault/", headers=self.headers)
            resp.raise_for_status()
            return resp.json()

    def write_note(self, path: str, content: str) -> Dict[str, Any]:
        """สร้าง/เขียนทับโน้ต"""
        full_path = f"{self.base_url}/vault/{path.lstrip('/')}"
        with httpx.Client(verify=self.verify_ssl, timeout=10.0) as client:
            resp = client.post(full_path, content=content, headers=self.headers)
            resp.raise_for_status()
            return resp.json()

    def read_note(self, path: str) -> Note:
        """อ่านเนื้อหาโน้ต"""
        full_path = f"{self.base_url}/vault/{path.lstrip('/')}"
        with httpx.Client(verify=self.verify_ssl, timeout=10.0) as client:
            resp = client.get(full_path, headers=self.headers)
            resp.raise_for_status()
            return Note(path=path, content=resp.text)

    def append_to_note(self, path: str, content: str, separator: str = "\n") -> Dict[str, Any]:
        """เพิ่มเนื้อหาต่อท้าย"""
        try:
            existing = self.read_note(path)
            new_content = existing.content + separator + content
        except httpx.HTTPStatusError as e:
            if e.response.status_code == 404:
                new_content = content
            else:
                raise
        return self.write_note(path, new_content)
 
 
 
 
