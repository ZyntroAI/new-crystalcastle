    function renderFileTree() {
      const root = $('#fileTree');
      root.innerHTML = '';
      state.folders.forEach(folder => {
        const head = document.createElement('div');
        head.className = 'row-card';
        head.innerHTML = `<div class="row-main"><div class="row-title">${folder.expanded ? '📂' : '📁'} ${escapeHtml(folder.name)}</div></div><span class="tag">folder</span>`;
        head.oncontextmenu = e => { e.preventDefault(); openContextMenu(e.clientX, e.clientY, folder.id, 'folder'); };
        head.onclick = () => { folder.expanded = !folder.expanded; renderFileTree(); persistState(); };
        root.appendChild(head);
        if (folder.expanded) {
          const children = document.createElement('div');
          children.className = 'tree-children';
