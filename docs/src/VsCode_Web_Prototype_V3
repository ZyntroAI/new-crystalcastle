    function renderDebug() {
      const list = $('#debugList');
      list.innerHTML = '';
      const info = [
        ['Active file', activeFile()?.name || '-'],
        ['Breakpoints', String(state.breakpoints.length)],
        ['Last run', 'Simulated runtime'],
