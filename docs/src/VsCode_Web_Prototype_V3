      document.documentElement.style.setProperty('--panel-height', `${state.panelHeight}px`);
      document.documentElement.style.setProperty('--sidebar-width', `${state.sidebarVisible ? state.sidebarWidth : 0}px`);
    }

    // ===================== Terminal =====================
    function appendTerminal(text, type='') {
      const div = document.createElement('div');
      div.className = 'line ' + type;
      div.textContent = text;
      $('#terminalOutput').appendChild(div);
      $('#terminalOutput').scrollTop = $('#terminalOutput').scrollHeight;
    }
    async function streamTerminal(text, type='system', delay=8) {
      const div = document.createElement('div');
      div.className = 'line ' + type;
      $('#terminalOutput').appendChild(div);
      for (const ch of text) {
        div.textContent += ch;
        $('#terminalOutput').scrollTop = $('#terminalOutput').scrollHeight;
        await new Promise(r => setTimeout(r, delay));
      }
    }
    function clearTerminal() {
      $('#terminalOutput').innerHTML = '';
      appendTerminal('Terminal cleared', 'system');
    }

    function runActiveFile() {
      const file = activeFile();
      if (!file) return;
      appendTerminal(`Running ${file.name}...`, 'system');
      setTimeout(() => appendTerminal(`Execution finished for ${file.name}`, 'ok'), 320);
    }
    function toggleBreakpoint() {
      const file = activeFile();
      if (!file) return;
      const key = `${file.id}:1`;
      if (state.breakpoints.includes(key)) state.breakpoints = state.breakpoints.filter(x => x !== key);
      else state.breakpoints.push(key);
      renderDebug();
      persistState();
      appendTerminal(`Breakpoint ${state.breakpoints.includes(key) ? 'added' : 'removed'} on ${file.name}:1`, 'warn');
    }

    async function handleTerminalCommand(raw) {
      const input = raw.trim();
      if (!input) return;
      appendTerminal(`${state.claudeMode ? 'claude>' : 'user@webide:~$'} ${input}`);
      state.commandHistory.push(input);
      state.historyIndex = state.commandHistory.length;
      persistState();

      if (state.claudeMode) {
        await handleClaudeCommand(input);
        return;
      }

      const [cmd, ...rest] = input.split(/\s+/);
      const arg = rest.join(' ');
      switch (cmd) {
        case 'help':
          appendTerminal('Commands: help, ls, cat, echo, pwd, cd, touch, mkdir, rm, clear, date, whoami, history, env, git, npm, node, python, open, save, theme, find, grep, calc, claude, settings, exit', 'system');
          break;
        case 'ls': appendTerminal(state.files.map(f => f.name).join('  ') || '(empty)', 'system'); break;
        case 'cat': {
          const file = state.files.find(f => f.name === arg);
          appendTerminal(file ? file.content : `cat: ${arg}: No such file`, file ? 'system' : 'err');
          break;
        }
        case 'echo': appendTerminal(arg, 'system'); break;
        case 'pwd': appendTerminal(state.cwd, 'system'); break;
        case 'cd': state.cwd = arg || '/'; appendTerminal(state.cwd, 'system'); persistState(); break;
        case 'touch':
          if (!arg) appendTerminal('touch: missing filename', 'err');
          else {
            const parent = state.folders[0]?.id || 'd-root';
            const file = { id: uid('f'), parentId: parent, name: arg, language: guessLanguage(arg), changed: true, content: '' };
            state.files.push(file);
            state.activeFileId = file.id;
            renderAll(); persistState(); appendTerminal(`created ${arg}`, 'ok');
          }
          break;
        case 'mkdir':
          if (!arg) appendTerminal('mkdir: missing folder name', 'err');
          else { state.folders.push({ id: uid('d'), name: arg, expanded: true }); renderFileTree(); persistState(); appendTerminal(`folder ${arg} created`, 'ok'); }
          break;
        case 'rm': {
          const idx = state.files.findIndex(f => f.name === arg);
          if (idx === -1) appendTerminal(`rm: ${arg}: No such file`, 'err');
          else {
            closeFile(state.files[idx].id);
            appendTerminal(`removed ${arg}`, 'ok');
          }
          break;
        }
        case 'clear': clearTerminal(); break;
        case 'date': appendTerminal(new Date().toString(), 'system'); break;
        case 'whoami': appendTerminal('web-ide-user', 'system'); break;
        case 'history': appendTerminal(state.commandHistory.join('\n'), 'system'); break;
        case 'env': appendTerminal('SHELL=prototype\nTERM=xterm-256color\nEDITOR=monaco\nPERSISTENCE=indexeddb\nVERSION=v3', 'system'); break;
        case 'git': handleGit(rest); break;
        case 'npm': handleNpm(rest); break;
        case 'node': appendTerminal('Node.js runtime simulated: console output placeholder', 'warn'); break;
        case 'python': appendTerminal('Python runtime simulated: print("hello from prototype")', 'warn'); break;
        case 'open': {
          const f = state.files.find(x => x.name === arg);
          if (!f) appendTerminal(`open: ${arg}: No such file`, 'err');
          else { openFile(f.id); appendTerminal(`opened ${f.name}`, 'ok'); }
          break;
        }
        case 'save': saveActiveFile(); break;
        case 'theme': appendTerminal(`Theme: ${state.settings.theme}`, 'system'); break;
        case 'find': {
          if (!arg) { appendTerminal('find: missing pattern', 'err'); break; }
          const hits = [];
          state.files.forEach(f => {
            f.content.split('\n').forEach((line, i) => { if (line.includes(arg)) hits.push(`${f.name}:${i+1}`); });
          });
          appendTerminal(hits.join('\n') || 'No matches', 'system');
          break;
        }
        case 'grep': {
          if (!arg) { appendTerminal('grep: missing pattern', 'err'); break; }
          const hits = [];
          state.files.forEach(f => {
            f.content.split('\n').forEach((line, i) => { if (line.toLowerCase().includes(arg.toLowerCase())) hits.push(`${f.name}:${i+1}: ${line.slice(0,80)}`); });
          });
          appendTerminal(hits.join('\n') || 'No matches', 'system');
          break;
        }
        case 'calc': {
          try { appendTerminal(String(Function('"use strict"; return (' + arg + ')')()), 'ok'); }
          catch { appendTerminal('calc: invalid expression', 'err'); }
          break;
        }
        case 'settings':
          switchSection('settings');
          appendTerminal('Opened settings panel', 'ok');
          break;
        case 'claude':
          state.claudeMode = true;
          renderStatusbar(); persistState();
          appendTerminal('Entered Claude Code REPL. Try /help, /tools, /model, /compact, /exit', 'ok');
          break;
        case 'exit': appendTerminal('Nothing to exit. Use claude to enter REPL first.', 'warn'); break;
        default: appendTerminal(`command not found: ${cmd}`, 'err');
      }
    }

    function handleGit(args) {
      const sub = args[0] || 'status';
      if (sub === 'status') {
        const changed = state.files.filter(f => f.changed).map(f => `modified: ${f.name}`).join('\n') || 'working tree clean';
        appendTerminal(changed, 'system');
      } else if (sub === 'add') {
        appendTerminal('Changes staged (simulated)', 'ok');
      } else if (sub === 'commit') {
        const msg = args.join(' ').replace(/^commit\s+-m\s+/, '') || 'prototype commit';
        state.files.forEach(f => f.changed = false);
        state.scmLog.push(msg);
        renderTabs(); renderFileTree(); renderScm(); persistState();
        appendTerminal(`[main] ${msg}`, 'ok');
      } else if (sub === 'log') {
        appendTerminal(state.scmLog.map((m, i) => `${state.scmLog.length - i}. ${m}`).join('\n'), 'system');
      } else if (sub === 'push') {
        appendTerminal('Pushed to origin/main (simulated)', 'ok');
      } else {
        appendTerminal(`git ${sub}: not implemented`, 'warn');
      }
    }

    function handleNpm(args) {
      const sub = args[0] || 'run';
      if (sub === 'install') appendTerminal('installed dependencies (simulated)', 'ok');
      else if (sub === 'start') appendTerminal('dev server started at http://localhost:3000 (simulated)', 'ok');
      else if (sub === 'test') appendTerminal('3 tests passed (simulated)', 'ok');
      else if (sub === 'build') appendTerminal('build complete in 0.9s (simulated)', 'ok');
      else appendTerminal(`npm ${sub}: script executed (simulated)`, 'system');
    }

    async function handleClaudeCommand(input) {
      if (input === '/exit') {
        state.claudeMode = false;
        renderStatusbar(); persistState();
        appendTerminal('Exited Claude Code REPL', 'ok');
        return;
      }
      if (input === '/help') { appendTerminal('/help  /tools  /model  /compact  /clear  /exit', 'system'); return; }
      if (input === '/tools') { appendTerminal('Tools: Read, Edit, Search, Refactor (simulated)', 'system'); return; }
      if (input === '/model') { appendTerminal('Model: simulated-claude-code', 'system'); return; }
      if (input === '/compact') { appendTerminal('Conversation compacted (simulated)', 'system'); return; }
      if (input === '/clear') { clearTerminal(); return; }

      const toolLine = /read|open|show/i.test(input)
        ? 'Tool call: Read(active file)'
        : /refactor|rename|edit|rewrite/i.test(input)
          ? 'Tool call: Edit(active file)'
          : 'Tool call: Search(project context)';
      await streamTerminal(toolLine, 'warn', 10);
      const file = activeFile();
      const reply = `Simulated Claude reply: I reviewed ${file ? file.name : 'the workspace'} and would preserve behavior while improving structure, naming, and maintainability. Your request was: "${input}".`;
      await streamTerminal(reply, 'system', 7);
      state.claudeTranscript.push({ role: 'user', content: input }, { role: 'assistant', content: reply });
      persistState();
    }

    // ===================== Menu & Palette =====================
    function handleMenu(menu, item) {
      const key = `${menu}:${item}`;
      closeMenus();
      switch (key) {
        case 'File:New File': createFile(); break;
        case 'File:Open Folder': openRealFolder(); break;
        case 'File:Save': saveActiveFile(); break;
        case 'File:Save All': saveAllFiles(); break;
        case 'Edit:Find in Files': switchSection('search'); $('#searchInput').focus(); break;
        case 'View:Toggle Sidebar': toggleSidebar(); break;
        case 'View:Toggle Terminal': toggleTerminal(); break;
        case 'View:Command Palette': openPalette(); break;
        case 'Run:Run Active File': runActiveFile(); break;
        case 'Run:Toggle Breakpoint': toggleBreakpoint(); break;
        case 'Terminal:Clear Terminal': clearTerminal(); break;
        case 'Help:Keyboard Shortcuts': appendTerminal('Ctrl+S Save · Ctrl+B Sidebar · Ctrl+` Terminal · Ctrl+P Search · Ctrl+Shift+P Palette · F5 Run · F9 Breakpoint', 'system'); break;
        case 'Help:About Prototype': appendTerminal('VS Code Web Prototype v3. Single-file shell with Monaco, real folder tree, terminal, Claude mode, IndexedDB, and File System Access API.', 'system'); break;
        default: appendTerminal(`Action executed: ${menu} › ${item}`, 'system');
      }
    }

