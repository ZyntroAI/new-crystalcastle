    // ===================== IndexedDB =====================
    async function openDb() {
      return new Promise((resolve, reject) => {
        const req = indexedDB.open(DB_NAME, 1);
        req.onupgradeneeded = () => {
          const d = req.result;
          if (!d.objectStoreNames.contains(STORE)) d.createObjectStore(STORE);
        };
        req.onsuccess = () => resolve(req.result);
        req.onerror = () => reject(req.error);
      });
    }
    async function getSavedState() {
      return new Promise(resolve => {
        const tx = db.transaction(STORE, 'readonly');
        const req = tx.objectStore(STORE).get('app-state');
        req.onsuccess = () => resolve(req.result || null);
        req.onerror = () => resolve(null);
      });
    }
    function persistState() {
      if (!db) return;
      try {
        state.commandHistory = limitArr(state.commandHistory, 500);
        state.claudeTranscript = limitArr(state.claudeTranscript, 200);
        const clean = JSON.parse(JSON.stringify(state));
        const tx = db.transaction(STORE, 'readwrite');
        tx.objectStore(STORE).put(clean, 'app-state');
        tx.onerror = () => console.error('IndexedDB write failed');
      } catch (e) {
        console.error('Persist failed', e);
      }
    }

    // ===================== UI Helpers =====================
    function toast(msg) {
      const el = document.createElement('div');
      el.className = 'toast';
      el.textContent = msg;
      $('#toastWrap').appendChild(el);
      setTimeout(() => el.remove(), 2200);
    }
    function setMonacoState(text, ok=false) {
      const chip = $('#monacoState');
      chip.textContent = text;
      chip.style.background = ok ? '#107c41' : '#0e639c';
    }

    // Modal dialog (replaces prompt())
    let modalResolve = null;
    function showModal(title, defaultValue='') {
      return new Promise(resolve => {
        modalResolve = resolve;
        $('#modalTitle').textContent = title;
        $('#modalInput').value = defaultValue;
        $('#modalOverlay').classList.add('open');
        $('#modalInput').focus();
        $('#modalInput').select();
      });
    }
    function closeModal(val) {
      $('#modalOverlay').classList.remove('open');
      if (modalResolve) { modalResolve(val); modalResolve = null; }
    }
    $('#modalCancel').onclick = () => closeModal(null);
    $('#modalOk').onclick = () => closeModal($('#modalInput').value);
    $('#modalInput').onkeydown = e => { if (e.key === 'Enter') closeModal($('#modalInput').value); if (e.key === 'Escape') closeModal(null); };

    // Context menu
    function openContextMenu(x, y, targetId, type) {
      ctxTarget = { id: targetId, type };
      const menu = $('#contextMenu');
      menu.style.left = x + 'px';
      menu.style.top = y + 'px';
      menu.classList.add('open');
    }
    function closeContextMenu() { $('#contextMenu').classList.remove('open'); ctxTarget = null; }
    window.addEventListener('click', e => { if (!e.target.closest('#contextMenu')) closeContextMenu(); });
    $all('#contextMenu .ctx-item').forEach(el => {
      el.onclick = () => {
        if (!ctxTarget) return;
        const action = el.dataset.action;
        if (action === 'rename') renameTarget(ctxTarget);
        if (action === 'delete') deleteTarget(ctxTarget);
        if (action === 'duplicate') duplicateTarget(ctxTarget);
        closeContextMenu();
      };
    });

    async function renameTarget({id, type}) {
      if (type === 'file') {
        const file = state.files.find(f => f.id === id);
        if (!file) return;
        const name = await showModal('Rename file', file.name);
        if (!name || !name.trim()) return;
        file.name = name.trim();
        file.language = guessLanguage(file.name);
        renderAll(); persistState();
      } else {
        const folder = state.folders.find(f => f.id === id);
        if (!folder) return;
        const name = await showModal('Rename folder', folder.name);
        if (!name || !name.trim()) return;
        folder.name = name.trim();
        renderAll(); persistState();
      }
    }
    async function deleteTarget({id, type}) {
      if (type === 'file') {
        const file = state.files.find(f => f.id === id);
        if (!file) return;
        const ok = await showModal(`Delete "${file.name}"? Type "yes" to confirm`);
        if (ok !== 'yes') return;
        closeFile(id);
      } else {
        const folder = state.folders.find(f => f.id === id);
        if (!folder) return;
        const ok = await showModal(`Delete folder "${folder.name}"? Type "yes" to confirm`);
        if (ok !== 'yes') return;
        state.folders = state.folders.filter(f => f.id !== id);
        state.files = state.files.filter(f => f.parentId !== id);
        if (!state.files.find(f => f.id === state.activeFileId)) {
          state.activeFileId = state.files[0]?.id || null;
        }
        renderAll(); persistState();
      }
    }
    function duplicateTarget({id, type}) {
      if (type !== 'file') return toast('Can only duplicate files');
      const file = state.files.find(f => f.id === id);
      if (!file) return;
      const newFile = { ...structuredClone(file), id: uid('f'), name: 'copy-of-' + file.name, changed: true };
      state.files.push(newFile);
      state.activeFileId = newFile.id;
      renderAll(); persistState();
    }

