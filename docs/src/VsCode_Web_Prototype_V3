            item.className = 'row-card';
            item.innerHTML = `<div class="row-main"><div class="row-title">📄 ${escapeHtml(file.name)}${file.changed ? ' ●' : ''}</div><div class="row-sub">${humanLang(file.language)}</div></div><span class="tag">${file.changed ? 'Modified' : 'Saved'}</span>`;
            item.onclick = () => openFile(file.id);
            item.oncontextmenu = e => { e.preventDefault(); openContextMenu(e.clientX, e.clientY, file.id, 'file'); };
            children.appendChild(item);
          });
          if (!folderFiles.length) {
            const empty = document.createElement('div');
            empty.className = 'muted';
