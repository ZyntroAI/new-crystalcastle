    function renderSettings() {
      const box = $('#settingsList');
      box.innerHTML = '';
      const s = state.settings;
      const rows = [
        { label: 'Font Size', key: 'fontSize', type: 'number', min: 8, max: 32 },
        { label: 'Word Wrap', key: 'wordWrap', type: 'select', opts: ['on', 'off', 'wordWrapColumn', 'bounded'] },
        { label: 'Minimap', key: 'minimap', type: 'toggle' },
        { label: 'Theme', key: 'theme', type: 'select', opts: ['vs-dark', 'vs', 'hc-black'] }
      ];
      rows.forEach(row => {
        const wrap = document.createElement('div');
        wrap.className = 'settings-row';
        const label = document.createElement('label');
        label.textContent = row.label;
        let control;
        if (row.type === 'number') {
          control = document.createElement('input');
          control.type = 'number';
          control.className = 'input';
          control.style.width = '80px';
          control.value = s[row.key];
          control.min = row.min; control.max = row.max;
          control.onchange = () => { s[row.key] = +control.value; applySettings(); };
        } else if (row.type === 'select') {
          control = document.createElement('select');
          control.className = 'select';
          control.style.width = '140px';
          row.opts.forEach(o => { const opt = document.createElement('option'); opt.value = o; opt.textContent = o; if (s[row.key] === o) opt.selected = true; control.appendChild(opt); });
          control.onchange = () => { s[row.key] = control.value; applySettings(); };
        } else {
          control = document.createElement('button');
          control.className = 'btn';
          control.textContent = s[row.key] ? 'Enabled' : 'Disabled';
          control.onclick = () => { s[row.key] = !s[row.key]; control.textContent = s[row.key] ? 'Enabled' : 'Disabled'; applySettings(); };
        }
        wrap.append(label, control);
        box.appendChild(wrap);
      });
    }

    function applySettings() {
      persistState();
      if (monacoReady) {
        editors.forEach(ed => {
          if (!ed._isDisposed) ed.updateOptions({
            theme: state.settings.theme,
            fontSize: state.settings.fontSize,
            minimap: { enabled: state.settings.minimap },
            wordWrap: state.settings.wordWrap
          });
        });
      }
      toast('Settings applied');
    }

