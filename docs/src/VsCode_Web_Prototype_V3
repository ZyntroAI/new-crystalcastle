    function guessLanguage(name) {
      const n = name.toLowerCase();
      if (n.endsWith('.js')) return 'javascript';
      if (n.endsWith('.ts')) return 'typescript';
      if (n.endsWith('.html')) return 'html';
      if (n.endsWith('.css')) return 'css';
      if (n.endsWith('.json')) return 'json';
      if (n.endsWith('.md')) return 'markdown';
      if (n.endsWith('.py')) return 'python';
      return 'plaintext';
    }

    function ensureEditorView(file) {
      let wrap = document.getElementById('editor-' + file.id);
      if (!wrap) {
        wrap = document.createElement('div');
        wrap.className = 'editor-view';
        wrap.id = 'editor-' + file.id;
        $('#editorStack').appendChild(wrap);
      }
      return wrap;
    }

    function createModelForFile(file) {
      if (!window.monaco) return null;
      if (models.has(file.id)) return models.get(file.id);
      const model = monaco.editor.createModel(file.content, file.language);
      model.onDidChangeContent(() => {
        file.content = model.getValue();
        file.changed = true;
        renderTabs();
        renderFileTree();
        renderScm();
        persistState();
      });
      models.set(file.id, model);
      return model;
    }

    function createMonacoEditor(file) {
      if (!monacoReady || !window.monaco) return;
      const wrap = ensureEditorView(file);
      if (editors.has(file.id)) {
        const ed = editors.get(file.id);
        if (!ed._isDisposed) return ed;
        editors.delete(file.id);
      }
      const model = createModelForFile(file);
      const editor = monaco.editor.create(wrap, {
        model,
        theme: state.settings.theme,
        automaticLayout: true,
        minimap: { enabled: state.settings.minimap },
        fontSize: state.settings.fontSize,
        lineNumbers: 'on',
        roundedSelection: false,
        scrollBeyondLastLine: false,
        wordWrap: state.settings.wordWrap,
        tabSize: 2,
        smoothScrolling: true,
      });
      editor.onDidChangeCursorPosition(e => {
        $('#statusCursor').textContent = `Ln ${e.position.lineNumber}, Col ${e.position.column}`;
      });
      editors.set(file.id, editor);
      return editor;
    }

    function upgradeAllToMonaco() {
      if (!monacoReady) return;
      state.files.forEach(file => {
        const wrap = ensureEditorView(file);
        const existing = wrap.querySelector('textarea');
        if (existing) existing.remove();
        createMonacoEditor(file);
      });
      renderEditors();
    }

    function renderEditors() {
      const empty = $('#editorEmpty');
      if (!state.files.length || !state.activeFileId) {
        empty.classList.remove('hidden');
        $all('.editor-view').forEach(v => v.classList.remove('active'));
        return;
      }
      empty.classList.add('hidden');
      const file = activeFile();
      if (!file) return;
      state.files.forEach(f => ensureEditorView(f));
      $all('.editor-view').forEach(v => v.classList.toggle('active', v.id === 'editor-' + file.id));
      if (monacoReady) {
        createMonacoEditor(file);
        const editor = editors.get(file.id);
        if (editor && !editor._isDisposed) {
          editor.focus();
          editor.layout();
          editor.setModel(createModelForFile(file));
          editor.updateOptions({
            theme: state.settings.theme,
            fontSize: state.settings.fontSize,
            minimap: { enabled: state.settings.minimap },
            wordWrap: state.settings.wordWrap
          });
        }
      } else {
        const wrap = ensureEditorView(file);
        let ta = wrap.querySelector('textarea');
        if (!ta) {
          ta = document.createElement('textarea');
          ta.style.cssText = 'width:100%;height:100%;background:#1e1e1e;color:#d4d4d4;border:0;outline:none;padding:12px 16px;font:14px Consolas,monospace;line-height:1.6;resize:none;';
          ta.oninput = () => {
            file.content = ta.value;
            file.changed = true;
            renderTabs(); renderFileTree(); renderScm(); persistState();
          };
          ta.onkeyup = ta.onclick = () => updateCursorFromTextarea(ta);
          wrap.appendChild(ta);
        }
        ta.value = file.content;
      }
      $('#statusLanguage').textContent = humanLang(file.language);
    }

    function updateCursorFromTextarea(ta) {
      const upTo = ta.value.slice(0, ta.selectionStart);
      const lines = upTo.split('\n');
      $('#statusCursor').textContent = `Ln ${lines.length}, Col ${lines[lines.length - 1].length + 1}`;
    }

    function openFile(id) {
      state.activeFileId = id;
      renderTabs();
      renderEditors();
      persistState();
    }

    function closeFile(id) {
      if (state.files.length === 1) return toast('Must keep at least 1 file');
      const idx = state.files.findIndex(f => f.id === id);
      if (idx === -1) return;
      const removed = state.files.splice(idx, 1)[0];
      if (models.has(removed.id)) { models.get(removed.id).dispose(); models.delete(removed.id); }
      if (editors.has(removed.id)) { editors.get(removed.id).dispose(); editors.delete(removed.id); }
      document.getElementById('editor-' + removed.id)?.remove();
      if (state.activeFileId === removed.id) {
        state.activeFileId = state.files[Math.max(0, idx - 1)]?.id || state.files[0]?.id || null;
      }
      renderAll();
      persistState();
    }

    async function createFile() {
      const name = await showModal('New file name', `file-${state.files.length + 1}.txt`);
      if (!name || !name.trim()) return;
      const trimmed = name.trim();
      if (state.files.some(f => f.name === trimmed)) return toast('File already exists');
      const parent = state.folders[0]?.id || 'd-root';
      const file = { id: uid('f'), parentId: parent, name: trimmed, language: guessLanguage(trimmed), changed: true, content: '' };
      state.files.push(file);
      state.activeFileId = file.id;
      renderAll();
      persistState();
      toast('Created ' + trimmed);
    }

    async function createFolder() {
      const name = await showModal('New folder name', `folder-${state.folders.length + 1}`);
      if (!name || !name.trim()) return;
      const trimmed = name.trim();
      if (state.folders.some(f => f.name === trimmed)) return toast('Folder already exists');
      state.folders.push({ id: uid('d'), name: trimmed, expanded: true });
      renderFileTree();
      persistState();
      toast('Created folder ' + trimmed);
    }

    function saveActiveFile() {
      const file = activeFile();
      if (!file) return;
      file.changed = false;
      renderTabs();
      renderFileTree();
      renderScm();
      persistState();
      appendTerminal(`Saved ${file.name}`, 'ok');
      toast(`Saved ${file.name}`);
    }

    function saveAllFiles() {
      state.files.forEach(f => f.changed = false);
      renderTabs(); renderFileTree(); renderScm(); persistState();
      appendTerminal('Saved all files', 'ok');
      toast('All files saved');
    }

    function switchSection(key) {
      state.activeSection = key;
      renderActivityBar();
      renderSidebar();
      persistState();
    }

    function renderSearchResults(query='') {
      const box = $('#searchResults');
      box.innerHTML = '';
      const q = query.trim().toLowerCase();
      if (!q) {
        box.innerHTML = '<div class="muted">Type to search</div>';
        return;
      }
      let count = 0;
      state.files.forEach(file => {
        file.content.split('\n').forEach((line, idx) => {
          if (line.toLowerCase().includes(q)) {
            count++;
            const row = document.createElement('div');
            row.className = 'row-card';
            row.innerHTML = `<div class="row-main"><div class="row-title">${escapeHtml(file.name)}</div><div class="row-sub">Ln ${idx + 1}: ${escapeHtml(line.slice(0, 120))}</div></div><span class="tag">Hit</span>`;
            row.onclick = () => {
              openFile(file.id);
              if (monacoReady && editors.get(file.id)) {
                const ed = editors.get(file.id);
                ed.revealLineInCenter(idx + 1);
                ed.setPosition({ lineNumber: idx + 1, column: Math.max(1, line.toLowerCase().indexOf(q) + 1) });
                ed.focus();
              }
            };
            box.appendChild(row);
          }
        });
      });
      if (!count) box.innerHTML = '<div class="muted">No results</div>';
    }

    function renderScm() {
      const list = $('#scmList');
      list.innerHTML = '';
      const changed = state.files.filter(f => f.changed);
      if (!changed.length) {
        list.innerHTML = '<div class="muted">Working tree clean</div>';
