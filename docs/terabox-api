  // =====================================================
  // 🎯 Generate Form HTML
  // =====================================================
  function generateForm(endpoint, method, spec) {
    const operation = findOperation(spec, endpoint, method);
    if (!operation) {
      return `<div class="form-empty">⚠️ ไม่พบ operation สำหรับ <code>${method} ${endpoint}</code></div>`;
    }

    const parts = [];

    // ─── Path params ───
    const pathParams = (operation.parameters || []).filter(p => p.in === 'path');
    if (pathParams.length) {
      parts.push(renderParamGroup('🛣️ Path', 'path', pathParams));
    }

    // ─── Query params ───
    const queryParams = (operation.parameters || []).filter(p => p.in === 'query');
    if (queryParams.length) {
      parts.push(renderParamGroup('🔍 Query', 'query', queryParams));
    }

    // ─── Headers ───
    const headerParams = (operation.parameters || []).filter(p => p.in === 'header');
    if (headerParams.length) {
      parts.push(renderParamGroup('📨 Headers', 'header', headerParams));
    }

    // ─── Request body ───
    const bodySchema = operation.requestBody?.content?.['application/json']?.schema;
    if (bodySchema) {
      const resolved = resolveSchema(bodySchema, spec);
      parts.push(renderBodyGroup(resolved, spec));
    }

    // ─── Multipart ───
    const formSchema = operation.requestBody?.content?.['multipart/form-data']?.schema;
    if (formSchema) {
      const resolved = resolveSchema(formSchema, spec);
      parts.push(renderMultipartGroup(resolved, spec));
    }

    if (parts.length === 0) {
      return `<div class="form-empty">✨ ไม่มีพารามิเตอร์ — ยิงได้เลย</div>`;
    }

    return `
      <form class="auto-form" data-endpoint="${escapeHtml(endpoint)}" data-method="${method}">
        ${parts.join('')}
        <div class="auto-form-actions">
          <button type="submit" class="btn btn-primary">▶ ส่งคำขอ</button>
          <button type="reset" class="btn btn-ghost">↺ รีเซ็ต</button>
        </div>
      </form>
    `;
  }

  // =====================================================
  // 📋 Param Group
  // =====================================================
  function renderParamGroup(title, inType, params) {
    return `
      <fieldset class="auto-form-group" data-in="${inType}">
        <legend>${title}</legend>
        ${params.map(p => renderParamField(p)).join('')}
      </fieldset>
    `;
  }

  function renderParamField(param) {
    const schema = param.schema || {};
    const required = param.required ? 'required' : '';
    const requiredBadge = param.required ? '<span class="required">*</span>' : '';
    const name = param.name;
    const id = `field-${param.in}-${name}`;
    const value = schema.default ?? schema.example ?? '';
    const placeholder = schema.example || param.description || '';

    let input;

    // Enum → select
    if (schema.enum) {
      input = `
        <select name="${escapeHtml(name)}" id="${id}" ${required}>
          ${schema.enum.map(v => `
            <option value="${escapeHtml(v)}" ${v === value ? 'selected' : ''}>${escapeHtml(v)}</option>
          `).join('')}
        </select>
      `;
    }
    // Boolean → checkbox
    else if (schema.type === 'boolean') {
      input = `
        <label class="auto-form-checkbox">
          <input type="checkbox" name="${escapeHtml(name)}" id="${id}" ${value === true ? 'checked' : ''}>
          <span>${escapeHtml(placeholder || name)}</span>
        </label>
      `;
    }
    // Number / integer
    else if (schema.type === 'number' || schema.type === 'integer') {
      input = `
        <input
          type="number"
          name="${escapeHtml(name)}"
          id="${id}"
          value="${escapeHtml(String(value))}"
          placeholder="${escapeHtml(placeholder)}"
          step="${schema.type === 'integer' ? '1' : 'any'}"
          ${schema.minimum != null ? `min="${schema.minimum}"` : ''}
          ${schema.maximum != null ? `max="${schema.maximum}"` : ''}
          ${required}
        >
      `;
    }
    // String
    else {
      input = `
        <input
          type="text"
          name="${escapeHtml(name)}"
          id="${id}"
          value="${escapeHtml(String(value))}"
          placeholder="${escapeHtml(placeholder)}"
          ${schema.maxLength ? `maxlength="${schema.maxLength}"` : ''}
          ${required}
        >
      `;
    }

    return `
      <div class="auto-form-field">
        <label for="${id}">
          <code>${escapeHtml(name)}</code>
          ${requiredBadge}
          <span class="auto-form-type">${escapeHtml(schema.type || 'string')}</span>
        </label>
        ${input}
        ${param.description ? `<div class="auto-form-hint">${escapeHtml(param.description)}</div>` : ''}
      </div>
    `;
  }

  // =====================================================
  // 📦 Body Group (JSON editor)
  // =====================================================
  function renderBodyGroup(schema, spec) {
    const example = generateExample(schema, spec);

    return `
      <fieldset class="auto-form-group" data-in="body">
        <legend>📦 Request Body <span class="auto-form-type">${escapeHtml(schema.type || 'object')}</span></legend>
        <div class="auto-form-field">
          <label><code>JSON</code></label>
          <textarea
            name="__body__"
            class="auto-form-json-editor"
            rows="10"
            spellcheck="false"
          >${escapeHtml(JSON.stringify(example, null, 2))}</textarea>
          <div class="auto-form-actions-inline">
            <button type="button" class="btn btn-ghost btn-sm" data-format-json>✨ จัดรูปแบบ</button>
            <button type="button" class="btn btn-ghost btn-sm" data-validate-json>✓ ตรวจสอบ</button>
          </div>
        </div>
      </fieldset>
    `;
  }

  // =====================================================
  // 📁 Multipart Group
  // =====================================================
  function renderMultipartGroup(schema, spec) {
    const props = schema.properties || {};
    const required = schema.required || [];

    return `
      <fieldset class="auto-form-group" data-in="multipart">
        <legend>📁 Form Data (multipart)</legend>
        ${Object.entries(props).map(([name, propSchema]) => {
          const isRequired = required.includes(name);
          const id = `field-multipart-${name}`;
          const isFile = propSchema.format === 'binary' || propSchema.type === 'string' && propSchema.format === 'binary';

          const input = isFile
            ? `<input type="file" name="${escapeHtml(name)}" id="${id}" ${isRequired ? 'required' : ''}>`
            : `<input type="text" name="${escapeHtml(name)}" id="${id}" placeholder="${escapeHtml(propSchema.example || '')}" ${isRequired ? 'required' : ''}>`;

          return `
            <div class="auto-form-field">
              <label for="${id}">
                <code>${escapeHtml(name)}</code>
                ${isRequired ? '<span class="required">*</span>' : ''}
                <span class="auto-form-type">${escapeHtml(propSchema.type || 'string')}</span>
              </label>
              ${input}
            </div>
          `;
        }).join('')}
      </fieldset>
    `;
  }

  // =====================================================
  // 🌱 Generate Example from Schema
  // =====================================================
  function generateExample(schema, spec, depth = 0) {
    if (depth > 10) return null;
    if (!schema) return null;

    // Resolve $ref
    if (schema.$ref) {
      schema = resolveRef(schema.$ref, spec);
    }

    // Use example if available
    if (schema.example !== undefined) return schema.example;
    if (schema.default !== undefined) return schema.default;
    if (schema.enum?.length) return schema.enum[0];

    switch (schema.type) {
      case 'object':
      case undefined:
        if (schema.properties) {
          const obj = {};
          Object.entries(schema.properties).forEach(([k, v]) => {
            obj[k] = generateExample(v, spec, depth + 1);
          });
          return obj;
        }
        return {};

      case 'array':
        return schema.items ? [generateExample(schema.items, spec, depth + 1)] : [];

      case 'string':
        if (schema.format === 'date') return new Date().toISOString().split('T')[0];
        if (schema.format === 'date-time') return new Date().toISOString();
        if (schema.format === 'email') return 'user@example.com';
        if (schema.format === 'uuid') return crypto.randomUUID();
        if (schema.format === 'uri') return 'https://example.com';
        return 'string';

      case 'number':
      case 'integer':
        return schema.minimum ?? 0;

      case 'boolean':
        return false;

      default:
        return null;
    }
  }

  // =====================================================
  // 📚 Find Operation in Spec
  // =====================================================
  function findOperation(spec, endpoint, method) {
    if (!spec?.paths) return null;

    // Exact match
    if (spec.paths[endpoint]?.[method.toLowerCase()]) {
      return spec.paths[endpoint][method.toLowerCase()];
    }

    // Fuzzy match: แทน {xxx} ด้วย regex
    const normalizedEndpoint = endpoint.replace(/\{[^}]+\}/g, '{param}');
    for (const [path, methods] of Object.entries(spec.paths)) {
      const normalizedPath = path.replace(/\{[^}]+\}/g, '{param}');
      if (normalizedPath === normalizedEndpoint) {
        return methods[method.toLowerCase()];
      }
    }

    return null;
  }

  function resolveRef(ref, spec) {
    if (!ref.startsWith('#/')) return null;
    const parts = ref.slice(2).split('/');
    let obj = spec;
    for (const p of parts) {
      obj = obj?.[p];
      if (!obj) return null;
    }
    return obj;
  }

  function resolveSchema(schema, spec) {
    if (schema.$ref) return resolveRef(schema.$ref, spec) || schema;
    return schema;
  }

  // =====================================================
  // 🎯 Form Data Extractor
  // =====================================================
  function extractFormData(form) {
    const data = {
      method: form.dataset.method,
      endpoint: form.dataset.endpoint,
      path: {},
      query: {},
      headers: {},
      body: null,
      formData: null,
    };

    const fd = new FormData(form);

    // Body JSON
    const bodyText = form.querySelector('[name="__body__"]')?.value;
    if (bodyText) {
      try { data.body = JSON.parse(bodyText); }
      catch { data.body = bodyText; }
    }

    // Multipart
    const fileInputs = form.querySelectorAll('[data-in="multipart"] input[type="file"]');
    if (fileInputs.length > 0) {
      data.formData = new FormData();
      form.querySelectorAll('[data-in="multipart"] input, [data-in="multipart"] select, [data-in="multipart"] textarea').forEach(el => {
        if (el.type === 'file') {
          if (el.files[0]) data.formData.append(el.name, el.files[0]);
        } else if (el.value) {
          data.formData.append(el.name, el.value);
        }
      });
    }

    // Path / Query / Headers
    fd.forEach((value, name) => {
      if (name === '__body__') return;
      const el = form.elements[name];
      if (!el) return;
      const inType = el.closest('[data-in]')?.dataset.in;
      if (inType === 'multipart') return;
      if (inType) data[inType][name] = value;
    });

    // Handle checkboxes (unchecked ไม่ขึ้นใน FormData)
    form.querySelectorAll('input[type="checkbox"]').forEach(cb => {
      const inType = cb.closest('[data-in]')?.dataset.in;
      if (inType && inType !== 'multipart') {
        data[inType][cb.name] = cb.checked;
      }
    });

    return data;
  }

