📡 2. sse-client.js — Server-Sent Events

```javascript
/* =====================================================
   📡 TeraBox SSE Client (แทน WebSocket)
   ===================================================== */
(function (global) {
  'use strict';

  const CFG = global.TeraBoxConfig;
  if (!CFG) return;

  const SSE = CFG.sse || {};
  const SSE_URL = SSE.url || `${CFG.apiBaseUrl}/docs/events`;

  const state = {
    eventSource: null,
    reconnectAttempts: 0,
    reconnectTimer: null,
    listeners: new Map(),    // eventName → Set<callback>
    lastEventId: null,
    connected: false,
  };

  const MAX_RECONNECT = SSE.maxReconnectAttempts || 10;
  const BASE_RECONNECT = SSE.baseReconnectDelay || 1000;

  // =====================================================
  // 🔌 Connect
  // =====================================================
  function connect(options = {}) {
    if (state.eventSource?.readyState === EventSource.OPEN) {
      console.log('📡 SSE already connected');
      return;
    }

    // สร้าง URL พร้อม token
    const url = new URL(SSE_URL);
    if (CFG.auth?.getToken) {
      const token = CFG.auth.getToken();
      if (token) url.searchParams.set('token', token);
    }
    if (options.topics) {
      url.searchParams.set('topics', options.topics.join(','));
    }
    if (state.lastEventId) {
      url.searchParams.set('lastEventId', state.lastEventId);
    }

    console.log('📡 Connecting SSE:', url.toString());

    try {
      state.eventSource = new EventSource(url.toString());

      // ─── Open ───
      state.eventSource.onopen = () => {
        state.connected = true;
        state.reconnectAttempts = 0;
        emit('open');
        console.log('✅ SSE connected');
      };

      // ─── Message (default event) ───
      state.eventSource.onmessage = (e) => {
        handleEvent('message', e);
      };

      // ─── Error ───
      state.eventSource.onerror = (e) => {
        state.connected = false;
        emit('error', e);

        if (state.eventSource.readyState === EventSource.CLOSED) {
          console.warn('⚠️ SSE closed — จะลองเชื่อมต่อใหม่');
          scheduleReconnect();
        } else {
          console.warn('⚠️ SSE error (auto-reconnecting)');
        }
      };

      // ─── Custom events ───
      // Listen to ทุก named events ที่ subscribe ไว้
      const allEvents = [
        'notification', 'message', 'upload:progress',
        'file:created', 'file:updated', 'file:deleted',
        'search:indexed', 'system:alert', 'docs:update',
      ];
      allEvents.forEach(name => {
        state.eventSource.addEventListener(name, (e) => handleEvent(name, e));
      });

    } catch (err) {
      console.error('SSE connect error:', err);
      scheduleReconnect();
    }
  }

  // =====================================================
  // 🔄 Reconnect
  // =====================================================
  function scheduleReconnect() {
    if (state.reconnectTimer) return;
    if (state.reconnectAttempts >= MAX_RECONNECT) {
      emit('reconnect:failed', { attempts: state.reconnectAttempts });
      console.error('❌ SSE reconnect attempts exceeded');
      return;
    }

    // Exponential backoff + jitter
    const delay = Math.min(
      BASE_RECONNECT * Math.pow(2, state.reconnectAttempts) + Math.random() * 1000,
      30000
    );

    state.reconnectAttempts++;
    emit('reconnect:scheduled', { attempt: state.reconnectAttempts, delay });

    state.reconnectTimer = setTimeout(() => {
      state.reconnectTimer = null;
      connect();
    }, delay);
  }

  // =====================================================
  // 📨 Handle Event
  // =====================================================
  function handleEvent(name, e) {
    let data = e.data;
    try { data = JSON.parse(data); } catch { /* keep as text */ }

    if (e.lastEventId) state.lastEventId = e.lastEventId;

    const payload = {
      type: name,
      data,
      id: e.lastEventId,
      timestamp: new Date().toISOString(),
    };

    emit(name, payload);
    emit('*', payload);  // wildcard listener

    // Call specific listeners
    const listeners = state.listeners.get(name);
    if (listeners) {
      listeners.forEach(cb => {
        try { cb(payload); } catch (err) { console.error(err); }
      });
    }
  }

  // =====================================================
  // 🔌 Disconnect
  // =====================================================
  function disconnect() {
    if (state.reconnectTimer) {
      clearTimeout(state.reconnectTimer);
      state.reconnectTimer = null;
    }
    if (state.eventSource) {
      state.eventSource.close();
      state.eventSource = null;
    }
    state.connected = false;
    state.reconnectAttempts = 0;
    emit('close');
    console.log('📡 SSE disconnected');
  }

  // =====================================================
  // 🎯 Public API
  // =====================================================
  const events = new EventTarget();
  const emit = (name, detail) => events.dispatchEvent(new CustomEvent(name, { detail }));

  const SSEClient = {
    connect,
    disconnect,

    /**
     * Subscribe to a specific event
     * @example
     *   SSEClient.subscribe('notification', (e) => console.log(e.data));
     */
    subscribe(eventName, callback) {
      if (!state.listeners.has(eventName)) {
        state.listeners.set(eventName, new Set());
      }
      state.listeners.get(eventName).add(callback);

      // Auto-connect ถ้ายังไม่เชื่อม
      if (!state.connected) connect();

      // Return unsubscribe
      return () => {
        const set = state.listeners.get(eventName);
        if (set) {
          set.delete(callback);
          if (set.size === 0) state.listeners.delete(eventName);
        }
      };
    },

    get connected() { return state.connected; },
    get lastEventId() { return state.lastEventId; },

    // Events
    on: (name, cb) => events.addEventListener(name, cb),
    off: (name, cb) => events.removeEventListener(name, cb),

    // For testing
    _state: state,
  };

  global.TeraBoxSSE = SSEClient;
})(window);
