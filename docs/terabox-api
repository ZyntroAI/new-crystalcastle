🔐 1. oauth2-client.js — OAuth2 Flow

```javascript
/* =====================================================
   🔐 TeraBox OAuth2 Client
   รองรับ Authorization Code + PKCE
   ===================================================== */
(function (global) {
  'use strict';

  const CFG = global.TeraBoxConfig;
  if (!CFG) return;

  const OAUTH = CFG.oauth2 || {};

  // =====================================================
  // 🔧 PKCE Helpers
  // =====================================================
  function base64UrlEncode(buffer) {
    return btoa(String.fromCharCode(...new Uint8Array(buffer)))
      .replace(/\+/g, '-')
      .replace(/\//g, '_')
      .replace(/=+$/, '');
  }

  function generateRandomString(length = 64) {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';
    const arr = new Uint8Array(length);
    crypto.getRandomValues(arr);
    return Array.from(arr, b => chars[b % chars.length]).join('');
  }

  async function generateCodeChallenge(verifier) {
    const data = new TextEncoder().encode(verifier);
    const hash = await crypto.subtle.digest('SHA-256', data);
    return base64UrlEncode(hash);
  }

  // =====================================================
  // 💾 Storage
  // =====================================================
  const storage = {
    set(key, value) {
      try { localStorage.setItem(`oauth_${key}`, JSON.stringify(value)); } catch {}
    },
    get(key) {
      try {
        const raw = localStorage.getItem(`oauth_${key}`);
        return raw ? JSON.parse(raw) : null;
      } catch { return null; }
    },
    remove(key) {
      try { localStorage.removeItem(`oauth_${key}`); } catch {}
    },
    clear() {
      ['access_token', 'refresh_token', 'id_token', 'token_expiry', 'verifier', 'state', 'user']
        .forEach(k => this.remove(k));
    },
  };

  // =====================================================
  // 🎯 State
  // =====================================================
  const state = {
    tokens: null,
    user: null,
    listeners: new Set(),
  };

  const events = new EventTarget();
  const emit = (name, detail) => events.dispatchEvent(new CustomEvent(name, { detail }));

  // =====================================================
  // 🔐 OAuth2 Flow
  // =====================================================

  /**
   * เริ่ม OAuth2 login flow (redirect ไปยัง authorization server)
   */
  async function login(options = {}) {
    if (!OAUTH.authorizationEndpoint || !OAUTH.clientId) {
      throw new Error('OAuth2 ไม่ได้ตั้งค่า — กรุณาตั้งใน config.js');
    }

    const verifier = generateRandomString(64);
    const challenge = await generateCodeChallenge(verifier);
    const stateParam = generateRandomString(32);

    storage.set('verifier', verifier);
    storage.set('state', stateParam);

    if (options.redirectAfterLogin) {
      storage.set('redirect_after', options.redirectAfterLogin);
    }

    const params = new URLSearchParams({
      client_id: OAUTH.clientId,
      redirect_uri: OAUTH.redirectUri || `${location.origin}/oauth/callback`,
      response_type: 'code',
      scope: (OAUTH.scopes || ['read', 'write']).join(' '),
      state: stateParam,
      code_challenge: challenge,
      code_challenge_method: 'S256',
      ...(options.extraParams || {}),
    });

    const url = `${OAUTH.authorizationEndpoint}?${params}`;
    console.log('🔐 Redirecting to OAuth2:', url);

    // Redirect (หรือ popup ถ้าต้องการ)
    if (options.usePopup) {
      return openPopup(url);
    }
    location.href = url;
  }

  /**
   * เปิด popup สำหรับ OAuth2
   */
  function openPopup(url) {
    return new Promise((resolve, reject) => {
      const w = 600, h = 700;
      const left = (screen.width - w) / 2;
      const top = (screen.height - h) / 2;

      const popup = window.open(
        url, 'oauth2_popup',
        `width=${w},height=${h},left=${left},top=${top},resizable=yes,scrollbars=yes`
      );

      if (!popup) {
        reject(new Error('Popup ถูกบล็อก — กรุณาอนุญาต popup'));
        return;
      }

      // Poll ว่า popup ปิดหรือยัง
      const timer = setInterval(() => {
        if (popup.closed) {
          clearInterval(timer);
          // ตรวจสอบว่า login สำเร็จหรือไม่
          if (state.tokens) resolve(state.tokens);
          else reject(new Error('ผู้ใช้ปิด popup'));
        }
      }, 500);

      // Listen message จาก popup
      const handler = (e) => {
        if (e.origin !== location.origin) return;
        if (e.data?.type === 'oauth2_callback') {
          window.removeEventListener('message', handler);
          clearInterval(timer);
          popup.close();

          if (e.data.error) reject(new Error(e.data.error));
          else resolve(handleCallback(e.data.code, e.data.state));
        }
      };
      window.addEventListener('message', handler);
    });
  }

  /**
   * จัดการ callback (เรียกเมื่อ OAuth2 redirect กลับมา)
   */
  async function handleCallback(code, stateParam) {
    // ตรวจสอบ state (CSRF protection)
    const savedState = storage.get('state');
    if (savedState && savedState !== stateParam) {
      throw new Error('State ไม่ตรง — อาจถูก CSRF attack');
    }

    const verifier = storage.get('verifier');
    if (!verifier) {
      throw new Error('ไม่พบ code_verifier — กรุณา login ใหม่');
    }

    // แลก code → token
    const tokens = await exchangeCodeForTokens(code, verifier);

    storage.set('access_token', tokens.access_token);
    if (tokens.refresh_token) storage.set('refresh_token', tokens.refresh_token);
    if (tokens.id_token) storage.set('id_token', tokens.id_token);
    if (tokens.expires_in) {
      storage.set('token_expiry', Date.now() + tokens.expires_in * 1000);
    }

    state.tokens = tokens;

    // โหลดข้อมูล user
    try {
      state.user = await fetchUserInfo(tokens.access_token);
      storage.set('user', state.user);
    } catch (e) {
      console.warn('ไม่สามารถโหลด user info:', e);
    }

    // เคลียร์ verifier + state
    storage.remove('verifier');
    storage.remove('state');

    emit('login', { tokens, user: state.user });
    console.log('✅ OAuth2 login สำเร็จ');

    return tokens;
  }

  /**
   * แลก code เป็น tokens
   */
  async function exchangeCodeForTokens(code, verifier) {
    const res = await fetch(OAUTH.tokenEndpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({
        grant_type: 'authorization_code',
        code,
        redirect_uri: OAUTH.redirectUri || `${location.origin}/oauth/callback`,
        client_id: OAUTH.clientId,
        code_verifier: verifier,
      }),
    });

    if (!res.ok) {
      const error = await res.json().catch(() => ({}));
      throw new Error(error.error_description || `Token endpoint error: ${res.status}`);
    }

    return res.json();
  }

  /**
   * Refresh token
   */
  async function refresh() {
    const refreshToken = storage.get('refresh_token');
    if (!refreshToken) {
      throw new Error('ไม่พบ refresh_token');
    }

    const res = await fetch(OAUTH.tokenEndpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams({
        grant_type: 'refresh_token',
        refresh_token: refreshToken,
        client_id: OAUTH.clientId,
      }),
    });

    if (!res.ok) {
      // Refresh ไม่ได้ → logout
      logout();
      throw new Error('Refresh token หมดอายุ — กรุณา login ใหม่');
    }

    const tokens = await res.json();
    storage.set('access_token', tokens.access_token);
    if (tokens.refresh_token) storage.set('refresh_token', tokens.refresh_token);
    if (tokens.expires_in) {
      storage.set('token_expiry', Date.now() + tokens.expires_in * 1000);
    }

    state.tokens = tokens;
    emit('refresh', { tokens });
    return tokens;
  }

  /**
   * โหลด user info
   */
  async function fetchUserInfo(accessToken) {
    if (!OAUTH.userInfoEndpoint) return null;
    const res = await fetch(OAUTH.userInfoEndpoint, {
      headers: { Authorization: `Bearer ${accessToken}` },
    });
    if (!res.ok) throw new Error(`UserInfo error: ${res.status}`);
    return res.json();
  }

  /**
   * Logout
   */
  function logout(options = {}) {
    storage.clear();
    state.tokens = null;
    state.user = null;
    emit('logout');

    if (options.redirect !== false && OAUTH.endSessionEndpoint) {
      const params = new URLSearchParams({
        post_logout_redirect_uri: OAUTH.postLogoutRedirectUri || location.origin,
        ...(state.tokens?.id_token ? { id_token_hint: state.tokens.id_token } : {}),
      });
      location.href = `${OAUTH.endSessionEndpoint}?${params}`;
    }
  }

  /**
   * ตรวจสอบว่ามี token ที่ยังไม่หมดอายุหรือไม่
   */
  function isAuthenticated() {
    const token = storage.get('access_token');
    if (!token) return false;
    const expiry = storage.get('token_expiry');
    if (!expiry) return true;
    return Date.now() < expiry - 30000; // 30s buffer
  }

  /**
   * ดึง access token ที่พร้อมใช้ (auto-refresh ถ้าจำเป็น)
   */
  async function getValidAccessToken() {
    const expiry = storage.get('token_expiry');
    if (expiry && Date.now() > expiry - 60000) {
      // ใกล้หมดอายุ → refresh
      try {
        await refresh();
      } catch {
        return null;
      }
    }
    return storage.get('access_token');
  }

  /**
   * Auto-detect callback (เรียกที่ init)
   */
  async function handleRedirectCallback() {
    const params = new URLSearchParams(location.search);
    const code = params.get('code');
    const stateParam = params.get('state');
    const error = params.get('error');

    if (error) {
      emit('login:error', { error, description: params.get('error_description') });
      // ล้าง query
      history.replaceState(null, '', location.pathname);
      throw new Error(`OAuth2 error: ${error}`);
    }

    if (!code) return null;

    try {
      const tokens = await handleCallback(code, stateParam);

      // Redirect กลับ
      const redirect = storage.get('redirect_after') || location.pathname;
      storage.remove('redirect_after');
      history.replaceState(null, '', redirect);

      return tokens;
    } catch (err) {
      history.replaceState(null, '', location.pathname);
      throw err;
    }
  }

  // =====================================================
  // 🌐 Public API
  // =====================================================
  const OAuth2 = {
    login,
    logout,
    refresh,
    isAuthenticated,
    getValidAccessToken,
    handleRedirectCallback,

    get user() { return state.user || storage.get('user'); },
    get tokens() { return state.tokens; },

    // Events
    on: (name, cb) => events.addEventListener(name, cb),
    off: (name, cb) => events.removeEventListener(name, cb),

    // Utilities
    _pkce: { generateRandomString, generateCodeChallenge },
    _storage: storage,
  };

  global.TeraBoxOAuth2 = OAuth2;
})(window);
