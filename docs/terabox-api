(function (global) {
  'use strict';

  const CFG = global.TeraBoxConfig;
  if (!CFG) return;

  const STORAGE_KEY = 'terabox_analytics_events';
  const MAX_EVENTS = 500;

  // =====================================================
  // 💾 Event Store (localStorage)
  // =====================================================
  const store = {
    events: load(),

    add(event) {
      this.events.push({
        ...event,
        id: crypto.randomUUID(),
        timestamp: event.timestamp || Date.now(),
      });
      if (this.events.length > MAX_EVENTS) {
        this.events = this.events.slice(-MAX_EVENTS);
      }
      save(this.events);
      emit('event', event);
    },

    clear() {
      this.events = [];
      save(this.events);
      emit('clear');
    },

    getAll() { return this.events; },

    filter({ since, type, endpoint } = {}) {
      return this.events.filter(e => {
        if (since && e.timestamp < since) return false;
        if (type && e.type !== type) return false;
        if (endpoint && e.endpoint !== endpoint) return false;
        return true;
      });
    },
  };

  function load() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch { return []; }
  }

  function save(events) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(events)); } catch {}
  }

  const events = new EventTarget();
  const emit = (name, detail) => events.dispatchEvent(new CustomEvent(name, { detail }));

  // =====================================================
  // 📊 Compute Stats
  // =====================================================
  function computeStats(timeframe = 'session') {
    const now = Date.now();
    const cutoff = {
      session: 0,
      hour: now - 3600 * 1000,
      day: now - 86400 * 1000,
      week: now - 7 * 86400 * 1000,
      all: 0,
    }[timeframe] ?? 0;

    const events = store.filter({ since: cutoff });

    const total = events.length;
    const successes = events.filter(e => e.success).length;
    const errors = total - successes;

    const latencies = events.filter(e => e.latency != null).map(e => e.latency);
    const avgLatency = latencies.length
      ? Math.round(latencies.reduce((a, b) => a + b, 0) / latencies.length)
      : 0;
    const p95 = percentile(latencies, 95);
    const p50 = percentile(latencies, 50);

    // Group by endpoint
    const byEndpoint = groupBy(events, 'endpoint');

    // Group by method
    const byMethod = groupBy(events, 'method');

    // Group by status
    const byStatus = groupBy(events, e => `${Math.floor(e.status / 100)}xx`);

    // Timeline (last 24h, bucketed by hour)
    const timeline = timelineBuckets(events, 24);

    return {
      total,
      successes,
      errors,
      successRate: total ? (successes / total * 100).toFixed(1) : '0',
      avgLatency,
      p50,
      p95,
      byEndpoint,
      byMethod,
      byStatus,
      timeline,
      timeframe,
    };
  }

  function percentile(arr, p) {
    if (!arr.length) return 0;
    const sorted = [...arr].sort((a, b) => a - b);
    const idx = Math.ceil((p / 100) * sorted.length) - 1;
    return sorted[Math.max(0, idx)];
  }

  function groupBy(arr, keyFn) {
    const key = typeof keyFn === 'string' ? (e) => e[keyFn] : keyFn;
    return arr.reduce((acc, item) => {
      const k = key(item) || 'unknown';
      acc[k] = (acc[k] || 0) + 1;
      return acc;
    }, {});
  }

  function timelineBuckets(events, hours) {
    const now = Date.now();
    const bucket = 3600 * 1000;
    const buckets = Array(hours).fill(0).map((_, i) => ({
      time: now - (hours - i - 1) * bucket,
      count: 0,
      errors: 0,
    }));

    events.forEach(e => {
      const idx = Math.floor((e.timestamp - (now - hours * bucket)) / bucket);
      if (idx >= 0 && idx < hours) {
        buckets[idx].count++;
        if (!e.success) buckets[idx].errors++;
      }
    });

    return buckets;
  }

  // =====================================================
