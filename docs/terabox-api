        <div class="response-chip">
          <span class="response-chip-label">Size</span>
          <span class="response-chip-value">${formatBytes(size)}</span>
        </div>` : ''}
      </div>
    `;
  }

  // =====================================================
  // 🎯 Public API — Full Response Renderer
  // =====================================================
  function renderResponse(response, options = {}) {
    const { status, latency, headers, data, size } = response;

    const dataHTML = typeof data === 'string'
      ? `<pre class="raw-response"><code>${escapeHtml(data)}</code></pre>`
      : renderJSON(data, options);

    return `
      <div class="response-viewer">
        ${renderSummary({ status, latency, size })}
        <div class="response-tabs">
          <button class="response-tab active" data-tab="body">📄 Body</button>
          <button class="response-tab" data-tab="headers">📨 Headers</button>
          <button class="response-tab" data-tab="raw">⌨️ Raw</button>
        </div>
        <div class="response-tab-content active" data-tab-content="body">
          ${dataHTML}
        </div>
        <div class="response-tab-content" data-tab-content="headers">
          ${renderHeaders(headers)}
        </div>
        <div class="response-tab-content" data-tab-content="raw">
          <pre class="raw-response"><code>${escapeHtml(JSON.stringify(data, null, 2))}</code></pre>
        </div>
      </div>
    `;
  }

  // =====================================================
  // 🛠️ Helpers
  // =====================================================
  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, m => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[m]));
  }

  function truncate(str, n) {
    return str.length > n ? str.slice(0, n) + '…' : str;
  }

  function formatBytes(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(2) + ' MB';
  }

  // =====================================================
  // 🎯 Tab switching (delegate)
  // =====================================================
  document.addEventListener('click', (e) => {
    const tab = e.target.closest('.response-tab');
    if (!tab) return;
    const viewer = tab.closest('.response-viewer');
    if (!viewer) return;

    const tabName = tab.dataset.tab;
    viewer.querySelectorAll('.response-tab').forEach(t => t.classList.remove('active'));
    viewer.querySelectorAll('.response-tab-content').forEach(c => c.classList.remove('active'));
    tab.classList.add('active');
    viewer.querySelector(`[data-tab-content="${tabName}"]`)?.classList.add('active');
  });

  global.TeraBoxFormatter = {
    renderResponse,
    renderJSON,
    renderHeaders,
    renderSummary,
    escapeHtml,
    formatBytes,
  };
})(window);
