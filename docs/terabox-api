🎨 3. response-formatter.js — สวยกว่า JSON ดิบ

```javascript
/* =====================================================
   🎨 JSON Response Formatter
   แสดงผลแบบ tree + syntax highlight + collapse
   ===================================================== */
(function (global) {
  'use strict';

  // =====================================================
  // 🎨 Render JSON
  // =====================================================
  function renderJSON(data, options = {}) {
    const opts = {
      collapse: options.collapse ?? 2,
      showTypes: options.showTypes ?? true,
      showLineNumbers: false,
      maxDepth: options.maxDepth ?? 20,
      ...options,
    };

    const tree = buildTree(data, opts, 0);
    return `
      <div class="json-viewer" data-collapse-depth="${opts.collapse}">
        ${renderTreeNode(tree, 0, opts)}
      </div>
    `;
  }

  function buildTree(data, opts, depth) {
    const type = getType(data);

    if (type === 'object' || type === 'array') {
      const entries = type === 'array'
        ? data.map((v, i) => [i, v])
        : Object.entries(data);

      return {
        type,
        size: entries.length,
        children: depth >= opts.maxDepth
          ? null
          : entries.map(([k, v]) => ({
              key: k,
              value: buildTree(v, opts, depth + 1),
            })),
      };
    }

    return { type, value: data };
  }

  function getType(v) {
    if (v === null) return 'null';
    if (Array.isArray(v)) return 'array';
    return typeof v;
  }

  // =====================================================
  // 🌳 Render Tree Node
  // =====================================================
  function renderTreeNode(node, depth, opts) {
    if (node.type === 'object' || node.type === 'array') {
      if (node.children === null) {
        return `<span class="json-collapsed">… ${node.size} ${node.type === 'array' ? 'items' : 'keys'}</span>`;
      }

      const open = node.type === 'array' ? '[' : '{';
      const close = node.type === 'array' ? ']' : '}';
      const isCollapsed = depth >= opts.collapse;

      const childrenHTML = node.children.map((child, i) => {
        const isLast = i === node.children.length - 1;
        const keyHTML = node.type === 'array'
          ? `<span class="json-index">${child.key}</span>`
          : `<span class="json-key">"${escapeHtml(child.key)}"</span>`;

        return `
          <div class="json-line">
            ${keyHTML}<span class="json-colon">:</span>
            ${renderTreeNode(child.value, depth + 1, opts)}${isLast ? '' : '<span class="json-comma">,</span>'}
          </div>
        `;
      }).join('');

      return `
        <div class="json-node ${isCollapsed ? 'collapsed' : ''}" data-depth="${depth}">
          <span class="json-toggle" onclick="this.parentElement.classList.toggle('collapsed')"></span>
          <span class="json-brace">${open}</span>
          <span class="json-size">${node.size} ${node.type === 'array' ? 'items' : 'keys'}</span>
          <div class="json-children">${childrenHTML}</div>
          <span class="json-brace">${close}</span>
        </div>
      `;
    }

    // Primitive
    return renderPrimitive(node.value, node.type, opts);
  }

  function renderPrimitive(value, type, opts) {
    let display, cls;

    switch (type) {
      case 'string':
        display = `"${escapeHtml(value)}"`;
        cls = 'json-string';
        // URL → clickable
        if (/^https?:\/\//.test(value)) {
          display = `<a href="${escapeHtml(value)}" target="_blank" rel="noopener" class="json-link">"${escapeHtml(truncate(value, 80))}"</a>`;
        }
        // ISO Date → humanize
        if (/^\d{4}-\d{2}-\d{2}T/.test(value)) {
          display = `<span class="json-date" title="${escapeHtml(value)}">"${escapeHtml(value)}"</span>`;
        }
        break;
      case 'number':
        display = String(value);
        cls = 'json-number';
        break;
      case 'boolean':
        display = String(value);
        cls = value ? 'json-bool-true' : 'json-bool-false';
        break;
      case 'null':
        display = 'null';
        cls = 'json-null';
        break;
      default:
        display = String(value);
        cls = 'json-value';
    }

    const typeHint = opts.showTypes
      ? `<span class="json-type" title="${type}">${type[0]}</span>`
      : '';

    return `<span class="${cls}">${display}</span>${typeHint}`;
  }

  // =====================================================
  // 🌐 Render HTTP Headers
  // =====================================================
  function renderHeaders(headers) {
    const entries = Object.entries(headers || {});
    if (entries.length === 0) return '';

    return `
      <div class="http-headers">
        <div class="http-headers-title">📨 Response Headers</div>
        <div class="http-headers-list">
          ${entries.map(([k, v]) => `
            <div class="http-header-row">
              <span class="http-header-key">${escapeHtml(k)}</span>
              <span class="http-header-value">${escapeHtml(v)}</span>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }

  // =====================================================
  // 📊 Render Response Summary
  // =====================================================
  function renderSummary(response) {
    const { status, latency, size } = response;
    const statusClass = status < 300 ? 'ok' : status < 400 ? 'warn' : 'err';

    return `
      <div class="response-summary">
        <div class="response-chip ${statusClass}">
          <span class="response-chip-label">Status</span>
          <span class="response-chip-value">${status}</span>
        </div>
