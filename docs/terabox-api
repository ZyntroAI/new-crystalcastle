```javascript
/* =====================================================
   🔄 Service Worker — PWA Offline Support
   ===================================================== */

const VERSION = 'v1.1.0';
const STATIC_CACHE = `terabox-static-${VERSION}`;
const RUNTIME_CACHE = `terabox-runtime-${VERSION}`;
const API_CACHE = `terabox-api-${VERSION}`;

// ไฟล์ที่ต้อง cache ล่วงหน้า
const STATIC_ASSETS = [
  '/',
  '/index.html',
  '/offline.html',
  '/styles.css',
  '/app.js',
  '/config.js',
  '/docs-integration.js',
  '/oauth2-client.js',
  '/sse-client.js',
  '/response-formatter.js',
  '/openapi-form-generator.js',
  '/analytics-dashboard.js',
  '/manifest.json',
  '/openapi.yaml',
];

// =====================================================
// 🔧 INSTALL
// =====================================================
self.addEventListener('install', (event) => {
  console.log('[SW] Installing...', VERSION);

  event.waitUntil(
    caches.open(STATIC_CACHE).then((cache) => {
      return cache.addAll(STATIC_ASSETS).catch(err => {
        console.warn('[SW] บางไฟล์ cache ไม่สำเร็จ:', err);
      });
    }).then(() => self.skipWaiting())
  );
});

// =====================================================
// 🚀 ACTIVATE
// =====================================================
self.addEventListener('activate', (event) => {
  console.log('[SW] Activating...', VERSION);

  event.waitUntil(
    caches.keys().then((keys) => {
      return Promise.all(
        keys
          .filter(key => !key.includes(VERSION))
          .map(key => {
            console.log('[SW] Deleting old cache:', key);
            return caches.delete(key);
          })
      );
    }).then(() => self.clients.claim())
  );
});

// =====================================================
// 🌐 FETCH
// =====================================================
self.addEventListener('fetch', (event) => {
  const { request } = event;
  const url = new URL(request.url);

  // Skip: non-GET, chrome-extension, ws, cross-origin auth
  if (request.method !== 'GET') return;
  if (url.protocol === 'chrome-extension:') return;
  if (url.pathname.startsWith('/oauth/')) return;

  // ─── 1. API requests → Network first, cache fallback ───
  if (url.pathname.startsWith('/api/')) {
    event.respondWith(networkFirstApi(request));
    return;
  }

  // ─── 2. OpenAPI spec → Network first, cache fallback ───
  if (url.pathname.endsWith('.json') || url.pathname.endsWith('.yaml')) {
    event.respondWith(networkFirstApi(request));
    return;
  }

  // ─── 3. Navigate → Network first, cache fallback to offline.html ───
  if (request.mode === 'navigate') {
    event.respondWith(networkFirstNavigate(request));
    return;
  }

  // ─── 4. Static assets → Cache first ───
  event.respondWith(cacheFirst(request));
});

// =====================================================
// 🎯 Strategies
// =====================================================

// Cache first (static)
async function cacheFirst(request) {
  const cached = await caches.match(request);
  if (cached) return cached;

  try {
    const response = await fetch(request);
    if (response.ok) {
      const cache = await caches.open(RUNTIME_CACHE);
      cache.put(request, response.clone());
    }
    return response;
  } catch (err) {
    // Offline fallback
    return new Response('', { status: 503, statusText: 'Offline' });
  }
}

// Network first for API
async function networkFirstApi(request) {
  try {
    const response = await fetch(request);
    if (response.ok || response.status < 500) {
      const cache = await caches.open(API_CACHE);
      cache.put(request, response.clone());
    }
    return response;
  } catch (err) {
    const cached = await caches.match(request);
    if (cached) {
      // แนบ header บอกว่ามาจาก cache
      const headers = new Headers(cached.headers);
      headers.set('X-From-Cache', 'true');
      headers.set('X-Cached-At', cached.headers.get('date') || '');
      return new Response(cached.body, {
        status: cached.status,
        statusText: cached.statusText,
        headers,
      });
    }
    return new Response(JSON.stringify({
      error: 'offline',
      message: 'ไม่มีการเชื่อมต่อ — ไม่มีข้อมูลใน cache',
    }), {
      status: 503,
      headers: { 'Content-Type': 'application/json' },
    });
  }
}

// Network first for navigate
async function networkFirstNavigate(request) {
  try {
    const response = await fetch(request);
    const cache = await caches.open(STATIC_CACHE);
    cache.put(request, response.clone());
    return response;
  } catch (err) {
    const cached = await caches.match(request);
    if (cached) return cached;
    return caches.match('/offline.html');
  }
}

// =====================================================
// 💬 MESSAGE — Clear cache on demand
// =====================================================
self.addEventListener('message', (event) => {
  const { type, payload } = event.data || {};

  if (type === 'SKIP_WAITING') {
    self.skipWaiting();
  }

  if (type === 'CLEAR_CACHE') {
    event.waitUntil(
      caches.keys().then(keys => Promise.all(keys.map(k => caches.delete(k))))
        .then(() => event.source?.postMessage({ type: 'CACHE_CLEARED' }))
    );
  }

  if (type === 'CACHE_STATS') {
    event.waitUntil(
      caches.keys().then(async keys => {
        const stats = {};
        for (const key of keys) {
          const cache = await caches.open(key);
          const reqs = await cache.keys();
          stats[key] = reqs.length;
        }
        event.source?.postMessage({ type: 'CACHE_STATS_RESULT', payload: stats });
      })
    );
  }
});

// =====================================================
// 🔄 BACKGROUND SYNC
// =====================================================
self.addEventListener('sync', (event) => {
  if (event.tag === 'sync-pending-requests') {
    event.waitUntil(syncPendingRequests());
  }
});

async function syncPendingRequests() {
  // ดึง pending requests จาก IndexedDB (ในกรณีมี)
  console.log('[SW] Background sync triggered');
}
