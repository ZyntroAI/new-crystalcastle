```javascript
/* =====================================================
   🔐 OAUTH2 UI
   ===================================================== */
(function () {
  if (!window.TeraBoxOAuth2) return;

  const O = window.TeraBoxOAuth2;
  const els = {
    oauthEmpty: document.getElementById('oauthEmpty'),
    oauthUser: document.getElementById('oauthUser'),
    oauthAvatar: document.getElementById('oauthAvatar'),
    oauthName: document.getElementById('oauthName'),
    oauthEmail: document.getElementById('oauthEmail'),
    oauthLoginBtn: document.getElementById('oauthLoginBtn'),
    oauthPopupBtn: document.getElementById('oauthPopupBtn'),
    oauthLogoutBtn: document.getElementById('oauthLogoutBtn'),
  };

  if (!els.oauthEmpty) return;

  function updateUI() {
    const user = O.user;
    const isAuth = O.isAuthenticated();

    if (isAuth && user) {
      els.oauthEmpty.classList.add('hidden');
      els.oauthUser.classList.remove('hidden');
      els.oauthName.textContent = user.name || user.preferred_username || 'ผู้ใช้';
      els.oauthEmail.textContent = user.email || '';
      els.oauthAvatar.src = user.picture || `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 56 56"><rect width="56" height="56" fill="#3b82f6"/><text x="28" y="36" font-size="24" fill="white" text-anchor="middle" font-family="sans-serif">${(user.name || 'U')[0]}</text></svg>`)}`;
    } else {
      els.oauthEmpty.classList.remove('hidden');
      els.oauthUser.classList.add('hidden');
    }
  }

  els.oauthLoginBtn?.addEventListener('click', () => O.login());
  els.oauthPopupBtn?.addEventListener('click', async () => {
    try {
      await O.login({ usePopup: true });
      showToast('✅ เข้าสู่ระบบสำเร็จ');
    } catch (err) {
      showToast('❌ ' + err.message);
    }
  });
  els.oauthLogoutBtn?.addEventListener('click', () => {
    O.logout({ redirect: false });
    showToast('🚪 ออกจากระบบแล้ว');
  });

  O.on('login', () => { updateUI(); showToast('✅ เข้าสู่ระบบสำเร็จ'); });
  O.on('logout', () => { updateUI(); });

  // Handle callback ถ้ามี
  O.handleRedirectCallback().catch(err => {
    if (err.message) showToast('⚠️ ' + err.message);
  }).finally(updateUI);

  updateUI();
})();

/* =====================================================
   📡 SSE UI
   ===================================================== */
(function () {
  if (!window.TeraBoxSSE) return;

  const S = window.TeraBoxSSE;
  const els = {
    badge: document.getElementById('sseBadge'),
    log: document.getElementById('sseLog'),
    clearBtn: document.getElementById('sseClearBtn'),
  };

  if (!els.log) return;

  function addEvent({ type, data, timestamp }) {
    const empty = els.log.querySelector('.sse-empty');
    if (empty) empty.remove();

    const el = document.createElement('div');
    el.className = 'sse-event';
    el.innerHTML = `
      <div class="sse-event-head">
        <span class="sse-event-type">${escapeHtml(type)}</span>
        <span class="sse-event-time">${new Date(timestamp).toLocaleTimeString('th-TH')}</span>
      </div>
      <div class="sse-event-body">${escapeHtml(typeof data === 'string' ? data : JSON.stringify(data, null, 2))}</div>
    `;
    els.log.prepend(el);

    // จำกัด 100 events
    while (els.log.children.length > 100) {
      els.log.lastChild.remove();
    }
  }

  function updateBadge(connected) {
    els.badge.className = connected ? 'badge badge-ok' : 'badge badge-live';
    els.badge.innerHTML = connected
      ? '🟢 เชื่อมต่อแล้ว'
      : '<span class="dot-live"></span> กำลังเชื่อมต่อ...';
  }

  els.clearBtn?.addEventListener('click', () => {
    els.log.innerHTML = '<div class="sse-empty">ยังไม่มี events...</div>';
  });

  // Subscribe ทุก topic
  document.querySelectorAll('.sse-topic input').forEach(cb => {
    const topic = cb.value;
    if (cb.checked) {
      S.subscribe(topic, (e) => addEvent({ ...e, type: topic }));
    }
    cb.addEventListener('change', () => {
      if (cb.checked) S.subscribe(topic, (e) => addEvent({ ...e, type: topic }));
    });
  });

  S.on('open', () => updateBadge(true));
  S.on('close', () => updateBadge(false));
  S.on('error', () => updateBadge(false));

  // Auto-connect
  S.connect();
})();

/* =====================================================
   🧪 AUTO-FORM UI
   ===================================================== */
(function () {
  if (!window.TeraBoxFormGenerator || !window.TeraBoxDocs) return;

  const G = window.TeraBoxFormGenerator;
  const D = window.TeraBoxDocs;
  const F = window.TeraBoxFormatter;

  const els = {
    endpointSelect: document.getElementById('autoformEndpoint'),
    methodSelect: document.getElementById('autoformMethod'),
    container: document.getElementById('autoformContainer'),
    response: document.getElementById('autoformResponse'),
  };

  if (!els.container) return;

  // Populate endpoint select
  function populateEndpoints() {
    const spec = D.spec;
    if (!spec?.paths) return;

    els.endpointSelect.innerHTML = '<option value="">— เลือก endpoint —</option>';

    Object.entries(spec.paths).forEach(([path, methods]) => {
      Object.keys(methods).forEach(method => {
        const op = methods[method];
        const opt = document.createElement('option');
        opt.value = `${method.toUpperCase()}|${path}`;
        opt.textContent = `${method.toUpperCase()} ${path}${op.summary ? ' — ' + op.summary : ''}`;
        els.endpointSelect.appendChild(opt);
      });
    });
  }

  function generateForm() {
    const val = els.endpointSelect.value;
    if (!val) {
      els.container.innerHTML = '<div class="form-empty">เลือก endpoint เพื่อสร้างฟอร์ม</div>';
      return;
    }

    const [method, endpoint] = val.split('|');
    els.methodSelect.value = method;

    const html = G.generateForm(endpoint, method, D.spec);
    els.container.innerHTML = html;

    // Attach submit handler
    const form = els.container.querySelector('.auto-form');
    form?.addEventListener('submit', handleSubmit);
  }

  async function handleSubmit(e) {
    e.preventDefault();
    const form = e.target;

    try {
      const data = G.extractFormData(form);
      const result = await D.tryEndpoint(data.endpoint, data.method, { ...data.path, ...data.query }, data.body);

      // Render response
      els.response.classList.remove('hidden');
      els.response.innerHTML = F.renderResponse({
        status: result.status,
        latency: result.latency,
        headers: result.headers,
        data: result.data,
      });
    } catch (err) {
      els.response.classList.remove('hidden');
      els.response.innerHTML = `
        <div class="response-viewer" style="border-color: var(--danger);">
          <div style="padding: 20px; color: var(--danger);">
            ❌ ${escapeHtml(err.message)}
          </div>
        </div>
      `;
    }
  }

  els.endpointSelect?.addEventListener('change', generateForm);
  els.methodSelect?.addEventListener('change', generateForm);

  D.on('spec:loaded', populateEndpoints);
  D.on('ready', populateEndpoints);

  if (D.spec) populateEndpoints();
})();

/* =====================================================
   📊 ANALYTICS UI
   ===================================================== */
(function () {
  if (!window.TeraBoxAnalytics) return;

  const el = document.getElementById('analyticsDashboard');
  if (!el) return;

  function render() {
    window.TeraBoxAnalytics.renderDashboard(el, { timeframe: 'day' });
  }

  // Re-render ทุก 10 วิ
  setInterval(render, 10000);
  render();

  // Re-render เมื่อมี event ใหม่
  window.TeraBoxAnalytics.on('event', () => {
    // Debounce
    clearTimeout(window.__analyticsRenderTimer);
    window.__analyticsRenderTimer = setTimeout(render, 500);
  });
})();
