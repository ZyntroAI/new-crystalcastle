    container.querySelector('[data-analytics-clear]')?.addEventListener('click', () => {
      if (confirm('ล้างข้อมูล analytics ทั้งหมด?')) {
        store.clear();
        renderDashboard(container, options);
      }
    });
  }

  function renderStatCard(icon, label, value, variant = '') {
    return `
      <div class="analytics-stat ${variant}">
        <div class="analytics-stat-icon">${icon}</div>
        <div class="analytics-stat-value">${value}</div>
        <div class="analytics-stat-label">${label}</div>
      </div>
    `;
  }

  function renderTimeline(buckets) {
    const max = Math.max(...buckets.map(b => b.count), 1);
    return `
      <div class="timeline-chart">
        ${buckets.map(b => {
          const height = (b.count / max) * 100;
          const hasErrors = b.errors > 0;
          return `
            <div class="timeline-bar-wrap" title="${new Date(b.time).toLocaleString('th-TH')} · ${b.count} requests${hasErrors ? ` · ${b.errors} errors` : ''}">
              <div class="timeline-bar ${hasErrors ? 'has-errors' : ''}" style="height: ${Math.max(height, 2)}%"></div>
            </div>
          `;
        }).join('')}
      </div>
      <div class="timeline-labels">
        <span>${new Date(buckets[0].time).toLocaleTimeString('th-TH', { hour: '2-digit', minute: '2-digit' })}</span>
        <span>ตอนนี้</span>
      </div>
    `;
  }

  function renderTopList(byKey, total) {
    const entries = Object.entries(byKey)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 10);

    if (entries.length === 0) {
      return '<div class="analytics-empty">ยังไม่มีข้อมูล</div>';
    }

    return entries.map(([key, count]) => {
      const pct = total ? (count / total * 100).toFixed(1) : 0;
      return `
        <div class="analytics-list-item">
          <code>${escapeHtml(key)}</code>
          <div class="analytics-list-bar-wrap">
            <div class="analytics-list-bar" style="width: ${pct}%"></div>
          </div>
          <span class="analytics-list-count">${count}</span>
        </div>
      `;
    }).join('');
  }

  // =====================================================
  // 📥 Export
  // =====================================================
  function exportData() {
    const data = {
      exportedAt: new Date().toISOString(),
      version: CFG.version || '1.1.0',
      stats: computeStats('all'),
      events: store.getAll(),
    };

    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `terabox-analytics-${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
  }

  // =====================================================
  // 📊 Auto-track — listen to TeraBoxDocs events
  // =====================================================
  function attachToDocs() {
    const D = global.TeraBoxDocs;
    if (!D) {
      setTimeout(attachToDocs, 100);
      return;
    }

    D.on('try:success', ({ url, method, status, latency }) => {
      store.add({
        type: 'api_call',
        endpoint: extractEndpoint(url),
        method,
        status,
        latency,
        success: status >= 200 && status < 400,
      });
    });

    D.on('try:error', ({ url, method, error, latency }) => {
      store.add({
        type: 'api_call',
        endpoint: extractEndpoint(url),
        method,
        status: 0,
        latency,
        success: false,
        error: error.message,
      });
    });

    D.on('spec:loaded', ({ source }) => {
      store.add({ type: 'spec_loaded', source });
    });

    D.on('health', ({ healthy, latency }) => {
      store.add({ type: 'health_check', success: healthy, latency });
    });

    console.log('📊 Analytics attached');
  }

  function extractEndpoint(url) {
    try {
      const u = new URL(url);
      return u.pathname.replace(/\/api\/v1/, '');
    } catch { return url; }
  }

  // =====================================================
  // 🌐 Public API
  // =====================================================
  global.TeraBoxAnalytics = {
    track: (event) => store.add(event),
    computeStats,
    renderDashboard,
    export: exportData,
    clear: () => store.clear(),
    getEvents: () => store.getAll(),
    on: (name, cb) => events.addEventListener(name, cb),
    off: (name, cb) => events.removeEventListener(name, cb),
  };

  attachToDocs();
})(window);
