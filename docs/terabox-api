            <button class="btn btn-ghost btn-sm" data-analytics-clear>🗑️ ล้าง</button>
          </div>
        </div>

        <!-- Stats Grid -->
        <div class="analytics-stats">
          ${renderStatCard('📞', 'คำขอทั้งหมด', stats.total)}
          ${renderStatCard('✅', 'สำเร็จ', stats.successes, 'ok')}
          ${renderStatCard('❌', 'ผิดพลาด', stats.errors, stats.errors > 0 ? 'err' : '')}
          ${renderStatCard('📈', 'Success Rate', stats.successRate + '%',
            parseFloat(stats.successRate) > 95 ? 'ok' : 'warn')}
          ${renderStatCard('⚡', 'Avg Latency', stats.avgLatency + 'ms',
