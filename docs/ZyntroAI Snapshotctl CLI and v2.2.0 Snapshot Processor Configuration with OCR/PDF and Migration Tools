  timestamp_format: "%Y%m%d-%H%M%S"
  hash_algorithm: sha256

compression:
  algorithm: zstd
  level: 15
  separate_metadata: true

storage:
  primary:
    provider: s3
    bucket: zyntro-snapshots-prod
    region: ap-southeast-1
    prefix: "artifacts/snapshots/"
    encrypted: true
    kms_key_id: ${KMS_KEY_ID}
  replica:
    provider: s3
    bucket: zyntro-snapshots-dr
    region: us-west-2
    sync_delay_seconds: 300
  local_cache:
    path: /tmp/snapshots/
    max_gb: 20
    ttl_hours: 6

validation:
  pre_capture_checks:
    - name: verify-no-pii
      tool: pii-scan
      fail_on_found: true
    - name: compliance-check
      config: ./compliance.yml
      enforce_licensing: true
  post_capture_verification:
    - checksum_verify: true
    - size_sanity_check: { min_kb: 10, max_gb: 50 }
    - structure_validate: true
    - ocr_integrity_check: true
