Part 2: Python CLI — snapshotctl
Save as tools/snapshotctl.py → executable chmod +x tools/snapshotctl.py
#!/usr/bin/env python3
"""
snapshotctl — ZyntroAI Snapshot Processor CLI
Commands: capture | list | show | diff | migrate | restore
"""
import os, sys, json, hashlib, tarfile, subprocess, yaml, fnmatch
from datetime import datetime
from pathlib import Path
from typing import Dict, List, Optional, Tuple

import click
import boto3
from botocore.exceptions import ClientError

ENV = os.getenv("ENVIRONMENT", "dev")
CACHE_DIR = Path("/tmp/snapshots")
CACHE_DIR.mkdir(parents=True, exist_ok=True)

# ─── Config Loading ──────────────────────────────────────────
def load_config(config_path: str = "Snapshot-Processor.yaml") -> Dict:
    with open(config_path) as f:
        return yaml.safe_load(f)

def now_ts() -> str:
    return datetime.utcnow().strftime("%Y%m%d-%H%M%S")

def git_short_sha() -> str:
    return subprocess.check_output(["git", "rev-parse", "--short", "HEAD"], text=True).strip()

def snap_name(cfg: Dict) -> str:
    return cfg["naming"]["template"].format(
        ENVIRONMENT=ENV,
        TIMESTAMP=now_ts(),
        GIT_SHORT_SHA=git_short_sha()
    )

# ─── Redis Persistence Tuning ────────────────────────────────
def tune_redis_persistence(cfg: Dict):
    """Apply RDB/AOF persistence config to Redis server"""
    redis_cfg = cfg["capture_scope"]["infrastructure"]["redis"]["persistence"]
    host = cfg["capture_scope"]["infrastructure"]["redis"]["host"].replace("redis://","")
    
    def redis_set(key, val):
        subprocess.run(["redis-cli", "-h", host.split(":")[0], "CONFIG", "SET", key, str(val)], check=True)

    redis_set("save", f"{redis_cfg['rdb']['save_seconds']} {redis_cfg['rdb']['save_changes']}")
    redis_set("dbfilename", redis_cfg['rdb']['dbfilename'])
    redis_set("rdbcompression", redis_cfg['rdb']['rdbcompression'])
    redis_set("rdbchecksum", redis_cfg['rdb']['rdbchecksum'])
    redis_set("appendonly", redis_cfg['aof']['appendonly'])
    redis_set("appendfsync", redis_cfg['aof']['appendfsync'])
    redis_set("aof-rewrite-percentage", redis_cfg['aof']['aof_rewrite_percentage'])
    redis_set("aof-rewrite-min-size", redis_cfg['aof']['aof_rewrite_min_size'])
    click.echo("✅ Redis persistence tuned (RDB + AOF hybrid)")

# ─── OCR/PDF Artifact Handling ───────────────────────────────
def process_ocr_pdf(paths: List[Path], cfg: Dict) -> List[Dict]:
    """Extract text/layout from PDFs/images; return metadata"""
    import pytesseract
    from PIL import Image
    ocr_cfg = cfg["capture_scope"]["artifacts"]["ocr_pdf"]
    if not ocr_cfg["enabled"]:
        return []
    
    results = []
    for p in paths:
        info = {
            "path": str(p),
            "type": p.suffix.lower(),
            "size_bytes": p.stat().st_size,
            "sha256": sha256_file(p),
            "text_extracted": False,
            "confidence": None,
            "text_path": None
        }
        if p.suffix.lower() == ".pdf":
            try:
                from pdf2image import convert_from_path
                pages = convert_from_path(str(p))
                text_parts = []
                conf_sum, count = 0, 0
                for i, page in enumerate(pages):
                    data = pytesseract.image_to_data(page, output_type=pytesseract.Output.DICT)
                    text_parts.append(" ".join(data["text"]))
                    for c in data["conf"]:
                        if c != -1:
                            conf_sum += c; count += 1
                text_out = p.with_suffix(f".ocr.{ocr_cfg['text_output_format']}")
                text_out.write_text("\n".join(text_parts), encoding="utf-8")
                info["text_extracted"] = True
                info["text_path"] = str(text_out)
                info["page_count"] = len(pages)
                info["confidence"] = round(conf_sum/count, 2) if count else None
            except Exception as e:
                click.echo(f"⚠️ OCR failed {p}: {e}", err=True)
        elif p.suffix.lower() in ocr_cfg["formats"]:
            try:
                img = Image.open(p)
                data = pytesseract.image_to_data(img, output_type=pytesseract.Output.DICT)
                text = " ".join(data["text"])
                confs = [c for c in data["conf"] if c != -1]
                info["confidence"] = round(sum(confs)/len(confs), 2) if confs else None
                text_out = p.with_suffix(f".ocr.{ocr_cfg['text_output_format']}")
                text_out.write_text(text, encoding="utf-8")
                if info["confidence"] and info["confidence"] >= ocr_cfg["min_confidence_score"]*100:
                    info["text_extracted"] = True
                    info["text_path"] = str(text_out)
            except Exception as e:
                click.echo(f"⚠️ Image OCR failed {p}: {e}", err=True)
        
        if ocr_cfg["validate_ocr_output"]:
            if info["confidence"] and info["confidence"] < ocr_cfg["min_confidence_score"]*100:
                click.echo(f"⚠️ Low OCR confidence {p}: {info['confidence']}%")
        results.append(info)
    return results

def sha256_file(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()

# ─── Diff & Migration ────────────────────────────────────────
def compute_diff(snap_a: Dict, snap_b: Dict, cfg: Dict) -> Dict:
    """Compare two snapshot manifests and generate changes"""
    diff_cfg = cfg["diff_migration"]
    ignore = diff_cfg["ignore_patterns"]
    changes = {"added": [], "removed": [], "modified": [], "unchanged_count": 0}

    files_a = {item["path"]: item for item in snap_a["manifest"]}
    files_b = {item["path"]: item for item in snap_b["manifest"]}

    all_paths = set(files_a) | set(files_b)
    for path in all_paths:
        if any(fnmatch.fnmatch(path, pat) for pat in ignore):
            continue
        if path not in files_a:
            changes["added"].append(files_b[path])
        elif path not in files_b:
            changes["removed"].append(files_a[path])
        else:
            fa, fb = files_a[path], files_b[path]
            if fa["sha256"] != fb["sha256"] or fa.get("mtime") != fb.get("mtime"):
                changes["modified"].append({"path": path, "from": fa, "to": fb})
            else:
                changes["unchanged_count"] += 1

    changes["summary"] = {
        "added_count": len(changes["added"]),
        "removed_count": len(changes["removed"]),
        "modified_count": len(changes["modified"]),
        "unchanged_count": changes["unchanged_count"]
    }
    return changes

def generate_migration_script(diff: Dict, snap_id_a: str, snap_id_b: str, out_path: Path):
    """Create apply/rollback bash script from diff"""
    lines = [f"#!/bin/bash\n# Migration: {snap_id_a} → {snap_id_b}\nset -e\n"]
    lines.append("# --- APPLY ---\n")
    for item in diff["added"]:
        lines.append(f"echo '+ Added: {item['path']}'")
    for item in diff["modified"]:
        lines.append(f"echo '~ Updated: {item['path']}'")
    for item in diff["removed"]:
        lines.append(f"echo '- Removed: {item['path']}'")
    lines.append("\n# --- ROLLBACK ---\necho 'Rollback would restore from previous snapshot'\n")
    out_path.write_text("\n".join(lines), encoding="utf-8")
    out_path.chmod(0o755)
    return str(out_path)

# ─── S3 Storage Helpers ──────────────────────────────────────
def get_s3_client(cfg: Dict):
    s3 = cfg["storage"]["primary"]
    return boto3.client(
        "s3",
        region_name=s3["region"],
        aws_access_key_id=os.getenv("AWS_ACCESS_KEY_ID"),
        aws_secret_access_key=os.getenv("AWS_SECRET_ACCESS_KEY")
    )

def upload_file(s3, path: Path, bucket: str, key: str):
    s3.upload_file(str(path), bucket, key)

# ─── CLI Commands ────────────────────────────────────────────
@click.group()
@click.option("--config", default="Snapshot-Processor.yaml", help="Config file path")
@click.pass_context
def cli(ctx, config):
    ctx.ensure_object(dict)
    ctx.obj["cfg_path"] = config
    ctx.obj["cfg"] = load_config(config)

@cli.command()
@click.option("--reason", required=True, help="Snapshot trigger reason")
@click.option("--tune-redis", is_flag=True, help="Apply Redis persistence tuning first")
@click.pass_context
def capture(ctx, reason, tune_redis):
    """Capture a new snapshot"""
    cfg = ctx.obj["cfg"]
    if tune_redis:
        tune_redis_persistence(cfg)

    name = snap_name(cfg)
    work_dir = CACHE_DIR / name
    work_dir.mkdir(parents=True)

    manifest = {
        "snapshot_id": name,
        "timestamp": datetime.utcnow().isoformat(),
        "reason": reason,
        "environment": ENV,
        "git_sha": git_short_sha(),
        "manifest": []
    }

    # Capture artifact paths including OCR/PDF
    art_paths = []
    for pfx in cfg["capture_scope"]["artifacts"]["paths"]:
        base = Path(pfx)
        if not base.exists():
            continue
        for f in base.rglob("*"):
            if f.is_file() and not any(fnmatch.fnmatch(str(f), pat) for pat in ["**/~*", "**/*.tmp"]):
                entry = {
                    "path": str(f.relative_to(Path.cwd())),
                    "size_bytes": f.stat().st_size,
                    "sha256": sha256_file(f),
                    "mtime": datetime.fromtimestamp(f.stat().st_mtime).isoformat()
                }
                manifest["manifest"].append(entry)
                art_paths.append(f)

    # OCR processing
    ocr_meta = process_ocr_pdf(art_paths, cfg)
    manifest["ocr_artifacts"] = ocr_meta

    # Save manifest
    mf_path = work_dir / "manifest.json"
    mf_path.write_text(json.dumps(manifest, indent=2), encoding="utf-8")

    # Compress
    tar_path = CACHE_DIR / f"{name}.tar.zst"
    subprocess.run(["tar", "-I", "zstd", "-cf", str(tar_path), "-C", str(work_dir), "."], check=True)

    # Upload
    s3 = get_s3_client(cfg)
    bucket = cfg["storage"]["primary"]["bucket"]
    prefix = cfg["storage"]["primary"]["prefix"]
    upload_file(s3, tar_path, bucket, f"{prefix}{name}.tar.zst")
    upload_file(s3, mf_path, bucket, f"{prefix}{name}-manifest.json")

    click.echo(f"✅ Snapshot captured: {name}")
    click.echo(f"   Size: {tar_path.stat().st_size/1024/1024:.2f} MB")

@cli.command()
@click.pass_context
def list(ctx):
    """List all stored snapshots"""
    cfg = ctx.obj["cfg"]
    s3 = get_s3_client(cfg)
    bucket = cfg["storage"]["primary"]["bucket"]
    prefix = cfg["storage"]["primary"]["prefix"]
    resp = s3.list_objects_v2(Bucket=bucket, Prefix=prefix)
    snaps = {}
    for obj in resp.get("Contents", []):
        if obj["Key"].endswith(".tar.zst"):
            id_ = obj["Key"].replace(prefix,"").replace(".tar.zst","")
            snaps[id_] = obj["LastModified"]
    for sid in sorted(snaps.keys(), reverse=True):
        click.echo(f"{sid}  |  {snaps[sid]}")

@cli.command()
@click.argument("snap_id")
@click.pass_context
def show(ctx, snap_id):
    """Show snapshot details"""
    cfg = ctx.obj["cfg"]
    s3 = get_s3_client(cfg)
    bucket = cfg["storage"]["primary"]["bucket"]
    prefix = cfg["storage"]["primary"]["prefix"]
    try:
        obj = s3.get_object(Bucket=bucket, Key=f"{prefix}{snap_id}-manifest.json")
        mf = json.loads(obj["Body"].read())
        click.echo(json.dumps(mf, indent=2))
    except ClientError:
        click.echo(f"❌ Snapshot not found: {snap_id}", err=True)

@cli.command()
@click.argument("snap_a")
@click.argument("snap_b")
@click.option("--script", help="Output migration script path")
@click.pass_context
def diff(ctx, snap_a, snap_b, script):
    """Diff two snapshots and optionally generate migration script"""
    cfg = ctx.obj["cfg"]
    s3 = get_s3_client(cfg)
    bucket = cfg["storage"]["primary"]["bucket"]
    prefix = cfg["storage"]["primary"]["prefix"]

    def load_manifest(sid):
        obj = s3.get_object(Bucket=bucket, Key=f"{prefix}{sid}-manifest.json")
        return json.loads(obj["Body"].read())

    mf_a = load_manifest(snap_a)
    mf_b = load_manifest(snap_b)

    diff_result = compute_diff(mf_a, mf_b, cfg)
    click.echo(json.dumps(diff_result, indent=2))

    if script:
        path = Path(script)
        generate_migration_script(diff_result, snap_a, snap_b, path)
        click.echo(f"\n📄 Migration script: {path}")

@cli.command()
@click.argument("snap_a")
@click.argument("snap_b")
@click.option("--output", default="./migration.sh", help="Script output path")
@click.option("--apply", is_flag=True, help="Auto-apply (caution!)")
@click.pass_context
def migrate(ctx, snap_a, snap_b, output, apply):
    """Generate migration script between snapshots"""
    ctx.invoke(diff, snap_a=snap_a, snap_b=snap_b, script=output)
    if apply:
        click.echo("⚠️ Auto-applying — this is destructive!")
        subprocess.run(["bash", output], check=True)

@cli.command()
@click.argument("snap_id")
@click.option("--profile", default="staging", type=click.Choice(["dev","staging","production"]))
@click.option("--dry-run", is_flag=True, default=True)
@click.pass_context
def restore(ctx, snap_id, profile, dry_run):
    """Restore snapshot to target profile"""
    cfg = ctx.obj["cfg"]
    prof = cfg["restore_profiles"][profile]
    if not prof["allowed"]:
        click.echo(f"❌ Profile {profile} not allowed — check config", err=True)
        return
    if profile == "production" and prof.get("require_approval"):
        click.echo("⚠️ Production restore requires approval gates — bypass with care")

    s3 = get_s3_client(cfg)
    bucket = cfg["storage"]["primary"]["bucket"]
    prefix = cfg["storage"]["primary"]["prefix"]
    tar_key = f"{prefix}{snap_id}.tar.zst"
    mf_key = f"{prefix}{snap_id}-manifest.json"

    local_tar = CACHE_DIR / f"{snap_id}.tar.zst"
    s3.download_file(bucket, tar_key, str(local_tar))

    click.echo(f"📦 Downloaded {snap_id} — {local_tar.stat().st_size/1024/1024:.2f} MB")
    if dry_run:
        click.echo("🧪 DRY RUN — extraction preview only")
        with tarfile.open(local_tar, "r:zstd") as tf:
            for m in tf.getmembers()[:20]:
                click.echo(f"   {m.name}")
        click.echo("... (preview only — remove --dry-run to apply)")
    else:
        dest = Path(f"./restore/{snap_id}")
        dest.mkdir(parents=True, exist_ok=True)
        with tarfile.open(local_tar, "r:zst") as tf:
            tf.extractall(dest)
        click.echo(f"✅ Restored to {dest}")

if __name__ == "__main__":
    cli()

