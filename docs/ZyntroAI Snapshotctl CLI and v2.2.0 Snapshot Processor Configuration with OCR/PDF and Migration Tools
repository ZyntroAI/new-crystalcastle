metadata:
  name: zyntro-snapshot-processor
  component: state-management
  version: "2.2"
  updated: 2026-09-26
  owner: DevOps / Engineering Lead

capture_scope:
  agent_state:
    enabled: true
    frameworks: [FIG, Claude, ZyntroCore]
    sources:
      - path: ./agents/state/
        label: agent-memory
        format: json
      - path: ./workflows/fig-definitions/
        label: fig-workflows
        format: yaml
      - path: ./knowledge-base/
        label: kb-articles
        format: markdown
    include_embeddings: true
    include_audit_trail: true

  repository:
    enabled: true
    git:
      capture_commit: true
      capture_branch: true
      capture_tags: true
      include_files:
        - "compliance.yml"
        - ".github/workflows/*.yml"
        - "docker-compose.*.yml"
        - "src/**/*.{py,ts,js}"
      exclude_paths: ["node_modules/", "dist/", "__pycache__/"]

  infrastructure:
    enabled: true
    redis:
      capture: true
      mode: hybrid  # RDB + AOF balanced
      host: redis://redis:6379
      keys_pattern: "zyntro:*"
      # === REDIS PERSISTENCE TUNING ===
      persistence:
        rdb:
          save_seconds: 300
          save_changes: 1000
          dbfilename: "dump.rdb"
          rdbcompression: yes
          rdbchecksum: yes
        aof:
          appendonly: "yes"
          appendfsync: everysec
          aof_rewrite_percentage: 100
          aof_rewrite_min_size: 64mb
          aof_use_rpreamble: yes

    docker:
      capture_volumes: true
      volume_patterns: ["zyntro-*-data", "snapshot-*"]
    database:
      capture_schema: true
      capture_seed: false
      type: postgresql

  # === OCR / PDF ARTIFACTS HANDLING ===
  artifacts:
    enabled: true
    paths:
      - ./output/
      - ./reports/
      - ./models/checkpoints/
      - ./ocr/raw/
      - ./ocr/processed/
      - ./documents/pdfs/
    ocr_pdf:
      enabled: true
      extract_text: true
      extract_images: true
      include_layout_metadata: true
      formats: [".pdf", ".png", ".jpg", ".jpeg", ".tiff", ".bmp"]
      text_output_format: markdown
      preserve_original: true
      validate_ocr_output: true
      min_confidence_score: 0.85
    retention:
      max_count: 10
      max_age_days: 90

schedule:
  mode: hybrid
  recurring:
    - name: hourly-checkpoint
      cron: "0 * * * *"
      retention_hours: 24
  event_driven:
    on_agent_deployment: true
    on_version_tag: true
    on_pipeline_complete: true
    on_ocr_batch_complete: true
    manual_trigger: true
  full_snapshot:
    cron: "0 2 * * 0"
    retention_count: 4

naming:
