      mention_channel: true
    - rollback_capture: true

restore_profiles:
  staging: { allowed: true, overwrite_unsafe: true, reset_connections: true }
  dev:
    allowed: true
    overwrite_unsafe: true
    partial_restore: [agent-memory, fig-workflows, ocr-processed]
  production:
    allowed: false
    require_approval: 2
    preserve_recent: true
    data_dry_run: true

# === DIFF & MIGRATION LOGIC ===
diff_migration:
  enabled: true
  diff_algorithm: recursive-hash
  detect:
    content_changes: true
    metadata_changes: true
    structural_changes: true
    ocr_text_drift: true
    embedding_vector_shift: 0.05  # cosine distance threshold
  output:
    format: both  # json + human-readable
    include_unchanged: false
    max_diff_lines: 5000
  migration:
    generate_script: true
    script_type: bash
    include_rollback: true
    auto_apply: false
    dry_run_default: true
  ignore_patterns:
    - "*.log"
    - "tmp/**"
    - ".DS_Store"

telemetry:
  metrics_export: prometheus
  metrics_port: 9104
  log_format: structured
  log_level: info

audit:
  enabled: true
  log_retention_days: 365
  fields: [snapshot_id, initiator, scope_size_gb, checksum, restore_target]

compliance:
  pdpa_thailand:
    data_classification: handled-per-policy
    pii_excluded: true
    encryption_at_rest: true
    cross_border_transfer: documented
  gdpr:
    right_to_be_forgotten_supported: true
    deletion_propagation: cascading

