# ─── Email (Nodemailer) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="MyApp Auth" <no-reply@example.com>

# ─── Token Secrets ───
EMAIL_VERIFICATION_SECRET=change-this-in-production-random-32-chars
PASSWORD_RESET_SECRET=change-this-in-production-random-32-chars

# ─── App URL ───
APP_URL=http://localhost:3000
